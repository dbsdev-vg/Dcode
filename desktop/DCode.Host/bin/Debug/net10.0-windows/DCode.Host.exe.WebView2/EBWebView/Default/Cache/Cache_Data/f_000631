{"relativePath":"src\\app\\playlists\\[id]\\page.tsx","content":"\"use client\";\r\n\r\nimport { useMemo, useState, useEffect, useRef } from \"react\";\r\nimport {\r\n  ArrowLeft,\r\n  Music2,\r\n  Play,\r\n  Plus,\r\n  Shuffle,\r\n  Trash2,\r\n  Search,\r\n  Check,\r\n  X,\r\n  Clock,\r\n  ArrowUpDown,\r\n  Pencil,\r\n  Heart,\r\n  MoreHorizontal,\r\n  ChevronDown,\r\n} from \"lucide-react\";\r\nimport { useParams, useRouter } from \"next/navigation\";\r\nimport { useLiveQuery } from \"dexie-react-hooks\";\r\nimport { db } from \"@/modules/db/db\";\r\nimport { useLibraryStore } from \"@/modules/library/library.store\";\r\nimport { usePlayerStore } from \"@/modules/player/player.store\";\r\nimport { formatTime } from \"@/lib/formatTime\";\r\n\r\ntype SortField = \"title\" | \"artist\" | \"album\" | \"dateAdded\" | \"duration\";\r\ntype SortOrder = \"asc\" | \"desc\";\r\n\r\nexport default function PlaylistPage() {\r\n  const params = useParams();\r\n  const router = useRouter();\r\n  const id = params.id as string;\r\n\r\n  const playlist = useLiveQuery(() => db.playlists.get(id), [id]);\r\n  const tracks = useLibraryStore((state) => state.tracks);\r\n  const { setQueue, playCurrent, toggleShuffle, currentTrack } =\r\n    usePlayerStore();\r\n\r\n  const [isAddModalOpen, setIsAddModalOpen] = useState(false);\r\n  const [isEditModalOpen, setIsEditModalOpen] = useState(false);\r\n  const [editName, setEditName] = useState(\"\");\r\n  const [searchQuery, setSearchQuery] = useState(\"\");\r\n  const [sortField, setSortField] = useState<SortField>(\"title\");\r\n  const [sortOrder, setSortOrder] = useState<SortOrder>(\"asc\");\r\n  const [selectedTracks, setSelectedTracks] = useState<string[]>([]);\r\n  const [isLiked, setIsLiked] = useState(false);\r\n  const [showSortMenu, setShowSortMenu] = useState(false);\r\n  const sortMenuRef = useRef<HTMLDivElement>(null);\r\n\r\n  // Close sort menu when clicking outside\r\n  useEffect(() => {\r\n    const handleClickOutside = (e: MouseEvent) => {\r\n      if (\r\n        sortMenuRef.current &&\r\n        !sortMenuRef.current.contains(e.target as Node)\r\n      ) {\r\n        setShowSortMenu(false);\r\n      }\r\n    };\r\n    document.addEventListener(\"mousedown\", handleClickOutside);\r\n    return () => document.removeEventListener(\"mousedown\", handleClickOutside);\r\n  }, []);\r\n\r\n  const playlistTracks = useMemo(() => {\r\n    if (!playlist) return [];\r\n    return tracks.filter((track) => playlist.trackIds.includes(track.id));\r\n  }, [playlist, tracks]);\r\n\r\n  const playlistDuration = useMemo(() => {\r\n    const totalSec = playlistTracks.reduce(\r\n      (sum, track) => sum + (track.duration || 0),\r\n      0,\r\n    );\r\n    const hours = Math.floor(totalSec / 3600);\r\n    const minutes = Math.floor((totalSec % 3600) / 60);\r\n    if (hours === 0 && minutes === 0) return \"0m\";\r\n    return hours > 0 ? `${hours}h ${minutes}m` : `${minutes}m`;\r\n  }, [playlistTracks]);\r\n\r\n  const filteredTracks = useMemo(() => {\r\n    let result = [...playlistTracks];\r\n    if (searchQuery.trim()) {\r\n      const q = searchQuery.toLowerCase();\r\n      result = result.filter(\r\n        (t) =>\r\n          t.title.toLowerCase().includes(q) ||\r\n          t.artist.toLowerCase().includes(q),\r\n      );\r\n    }\r\n    result.sort((a, b) => {\r\n      let aVal: string | number = \"\";\r\n      let bVal: string | number = \"\";\r\n      switch (sortField) {\r\n        case \"title\":\r\n          aVal = a.title.toLowerCase();\r\n          bVal = b.title.toLowerCase();\r\n          break;\r\n        case \"artist\":\r\n          aVal = a.artist.toLowerCase();\r\n          bVal = b.artist.toLowerCase();\r\n          break;\r\n        case \"album\":\r\n          aVal = (a.album || \"\").toLowerCase();\r\n          bVal = (b.album || \"\").toLowerCase();\r\n          break;\r\n        case \"duration\":\r\n          aVal = a.duration || 0;\r\n          bVal = b.duration || 0;\r\n          break;\r\n        case \"dateAdded\":\r\n          aVal = (a as any).dateAdded || 0;\r\n          bVal = (b as any).dateAdded || 0;\r\n          break;\r\n      }\r\n      if (aVal < bVal) return sortOrder === \"asc\" ? -1 : 1;\r\n      if (aVal > bVal) return sortOrder === \"asc\" ? 1 : -1;\r\n      return 0;\r\n    });\r\n    return result;\r\n  }, [playlistTracks, searchQuery, sortField, sortOrder]);\r\n\r\n  const libraryTracks = useLibraryStore((state) => state.tracks);\r\n  const availableTracks = useMemo(() => {\r\n    if (!playlist) return libraryTracks;\r\n    return libraryTracks.filter((t) => !playlist.trackIds.includes(t.id));\r\n  }, [libraryTracks, playlist]);\r\n  const [addSearch, setAddSearch] = useState(\"\");\r\n  const filteredAvailable = useMemo(() => {\r\n    if (!addSearch.trim()) return availableTracks;\r\n    const q = addSearch.toLowerCase();\r\n    return availableTracks.filter(\r\n      (t) =>\r\n        t.title.toLowerCase().includes(q) || t.artist.toLowerCase().includes(q),\r\n    );\r\n  }, [availableTracks, addSearch]);\r\n\r\n  async function updatePlaylistName(newName: string) {\r\n    if (!playlist || !newName.trim()) return;\r\n    await db.playlists.update(playlist.id, { name: newName.trim() });\r\n  }\r\n\r\n  async function removeTrack(trackId: string) {\r\n    if (!playlist) return;\r\n    await db.playlists.update(playlist.id, {\r\n      trackIds: playlist.trackIds.filter((id) => id !== trackId),\r\n    });\r\n  }\r\n\r\n  async function addSelectedTracks() {\r\n    if (!playlist || !selectedTracks.length) return;\r\n    const unique = [...new Set([...playlist.trackIds, ...selectedTracks])];\r\n    await db.playlists.update(playlist.id, { trackIds: unique });\r\n    setSelectedTracks([]);\r\n    setAddSearch(\"\");\r\n    setIsAddModalOpen(false);\r\n  }\r\n\r\n  function playPlaylist() {\r\n    if (!filteredTracks.length) return;\r\n    const { setQueue } = usePlayerStore.getState();\r\n    setQueue(filteredTracks, 0, false);\r\n    usePlayerStore.getState().playCurrent();\r\n  }\r\n\r\n  function shufflePlaylist() {\r\n    if (!filteredTracks.length) return;\r\n    const randomIndex = Math.floor(Math.random() * filteredTracks.length);\r\n    const { setQueue } = usePlayerStore.getState();\r\n    setQueue(filteredTracks, randomIndex, true);\r\n    usePlayerStore.getState().playCurrent();\r\n  }\r\n\r\n  function playTrackAtIndex(index: number) {\r\n    if (!filteredTracks.length) return;\r\n    const { setQueue, isShuffled } = usePlayerStore.getState();\r\n    // Respect current shuffle setting\r\n    setQueue(filteredTracks, index, isShuffled);\r\n    usePlayerStore.getState().playCurrent();\r\n  }\r\n\r\n  function toggleSort(field: SortField) {\r\n    if (sortField === field) {\r\n      setSortOrder(sortOrder === \"asc\" ? \"desc\" : \"asc\");\r\n    } else {\r\n      setSortField(field);\r\n      setSortOrder(\"asc\");\r\n    }\r\n    setShowSortMenu(false);\r\n  }\r\n\r\n  if (!playlist) {\r\n    return (\r\n      <div className=\"flex items-center justify-center h-screen bg-black\">\r\n        <div className=\"animate-pulse text-zinc-500\">Loading playlist...</div>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div className=\"min-h-screen bg-black pb-32 w-full max-w-[100vw] overflow-x-hidden\">\r\n      <div className=\"max-w-[1200px] mx-auto w-full\">\r\n        {/* Hero Section - responsive */}\r\n        <div className=\"relative bg-gradient-to-b from-[#E52C2C]/20 via-black to-black pt-6 pb-6 px-4 md:pt-8 md:pb-8\">\r\n          <button\r\n            onClick={() => router.back()}\r\n            className=\"absolute top-4 left-4 z-10 w-10 h-10 rounded-full bg-black/50 backdrop-blur-sm border border-white/10 flex items-center justify-center hover:bg-black/70 transition\"\r\n          >\r\n            <ArrowLeft size={20} />\r\n          </button>\r\n\r\n          <div className=\"flex flex-col items-center md:flex-row md:items-end gap-5 md:gap-8 pt-8 md:pt-12\">\r\n            {/* Cover – smaller on mobile */}\r\n            <div className=\"w-40 h-40 md:w-56 md:h-56 shadow-2xl shadow-red-900/30 rounded-2xl overflow-hidden flex-shrink-0\">\r\n              {playlist.cover ? (\r\n                <img\r\n                  src={playlist.cover}\r\n                  alt={playlist.name}\r\n                  className=\"w-full h-full object-cover\"\r\n                />\r\n              ) : (\r\n                <div className=\"w-full h-full bg-gradient-to-br from-[#E52C2C] to-[#a20707] flex items-center justify-center\">\r\n                  <Music2 size={48} className=\"text-white md:hidden\" />\r\n                  <Music2 size={64} className=\"text-white hidden md:block\" />\r\n                </div>\r\n              )}\r\n            </div>\r\n\r\n            {/* Info */}\r\n            <div className=\"flex-1 text-center md:text-left\">\r\n              <p className=\"text-xs md:text-sm text-zinc-400 uppercase tracking-wide\">\r\n                Playlist\r\n              </p>\r\n              <div className=\"flex items-center justify-center md:justify-start gap-2 mt-2\">\r\n                <h1 className=\"text-2xl md:text-5xl font-bold break-words max-w-[80%] md:max-w-full\">\r\n                  {playlist.name}\r\n                </h1>\r\n                <button\r\n                  onClick={() => {\r\n                    setEditName(playlist.name);\r\n                    setIsEditModalOpen(true);\r\n                  }}\r\n                  className=\"text-zinc-400 hover:text-white transition p-1\"\r\n                >\r\n                  <Pencil size={18} />\r\n                </button>\r\n              </div>\r\n              <div className=\"flex flex-wrap items-center justify-center md:justify-start gap-2 mt-3 text-xs md:text-sm text-zinc-400\">\r\n                <span className=\"font-medium text-white\">\r\n                  Daniel Dos Santos\r\n                </span>\r\n                <span className=\"hidden md:inline\">•</span>\r\n                <span>{playlistTracks.length} songs</span>\r\n                <span>•</span>\r\n                <span>{playlistDuration}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          {/* Action buttons – responsive wrap */}\r\n          <div className=\"flex flex-wrap justify-center md:justify-start gap-2 mt-6\">\r\n            <button\r\n              onClick={playPlaylist}\r\n              className=\"px-5 h-10 rounded-full bg-[#E52C2C] text-white flex items-center gap-2 font-medium shadow-lg shadow-red-900/30 hover:scale-105 transition active:scale-95\"\r\n            >\r\n              <Play size={16} fill=\"currentColor\" />\r\n              Play\r\n            </button>\r\n            <button\r\n              onClick={shufflePlaylist}\r\n              className=\"w-10 h-10 rounded-full bg-zinc-800/80 backdrop-blur-sm border border-white/10 flex items-center justify-center hover:bg-zinc-700 transition active:scale-95\"\r\n            >\r\n              <Shuffle size={16} />\r\n            </button>\r\n            <button\r\n              onClick={() => setIsLiked(!isLiked)}\r\n              className=\"w-10 h-10 rounded-full bg-zinc-800/80 backdrop-blur-sm border border-white/10 flex items-center justify-center hover:bg-zinc-700 transition active:scale-95\"\r\n            >\r\n              <Heart\r\n                size={16}\r\n                className={isLiked ? \"text-[#E52C2C] fill-[#E52C2C]\" : \"\"}\r\n              />\r\n            </button>\r\n            <button\r\n              onClick={() => setIsAddModalOpen(true)}\r\n              className=\"w-10 h-10 rounded-full bg-zinc-800/80 backdrop-blur-sm border border-white/10 flex items-center justify-center hover:bg-zinc-700 transition active:scale-95\"\r\n            >\r\n              <Plus size={16} />\r\n            </button>\r\n            <button className=\"w-10 h-10 rounded-full bg-zinc-800/80 backdrop-blur-sm border border-white/10 flex items-center justify-center hover:bg-zinc-700 transition\">\r\n              <MoreHorizontal size={16} />\r\n            </button>\r\n          </div>\r\n        </div>\r\n\r\n        {/* Search & Sort Bar – responsive */}\r\n        <div className=\"sticky top-0 z-20 bg-black/95 backdrop-blur-sm px-4 py-3 border-b border-zinc-800\">\r\n          <div className=\"flex flex-col sm:flex-row gap-3\">\r\n            <div className=\"relative flex-1\">\r\n              <Search\r\n                size={16}\r\n                className=\"absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500\"\r\n              />\r\n              <input\r\n                type=\"text\"\r\n                value={searchQuery}\r\n                onChange={(e) => setSearchQuery(e.target.value)}\r\n                placeholder=\"Search in playlist...\"\r\n                className=\"w-full h-10 bg-zinc-900 rounded-xl pl-9 pr-4 text-sm border border-zinc-800 focus:border-[#E52C2C] outline-none transition\"\r\n              />\r\n            </div>\r\n\r\n            {/* Sort button + dropdown (mobile friendly) */}\r\n            <div className=\"relative\" ref={sortMenuRef}>\r\n              <button\r\n                onClick={() => setShowSortMenu(!showSortMenu)}\r\n                className=\"flex items-center gap-2 px-4 h-10 rounded-xl bg-zinc-900 text-zinc-400 text-sm border border-zinc-800 hover:bg-zinc-800 transition\"\r\n              >\r\n                <ArrowUpDown size={14} />\r\n                Sort by:{\" \"}\r\n                {sortField === \"title\"\r\n                  ? \"Title\"\r\n                  : sortField === \"artist\"\r\n                    ? \"Artist\"\r\n                    : sortField === \"album\"\r\n                      ? \"Album\"\r\n                      : sortField === \"duration\"\r\n                        ? \"Duration\"\r\n                        : \"Date Added\"}\r\n                <ChevronDown\r\n                  size={14}\r\n                  className={`transition-transform ${showSortMenu ? \"rotate-180\" : \"\"}`}\r\n                />\r\n              </button>\r\n              {showSortMenu && (\r\n                <div className=\"absolute right-0 mt-2 w-44 bg-zinc-950 border border-zinc-800 rounded-xl shadow-xl z-30 overflow-hidden\">\r\n                  {(\r\n                    [\r\n                      \"title\",\r\n                      \"artist\",\r\n                      \"album\",\r\n                      \"duration\",\r\n                      \"dateAdded\",\r\n                    ] as SortField[]\r\n                  ).map((field) => (\r\n                    <button\r\n                      key={field}\r\n                      onClick={() => toggleSort(field)}\r\n                      className=\"w-full px-3 py-2 text-left text-sm hover:bg-zinc-800 flex justify-between items-center\"\r\n                    >\r\n                      <span>\r\n                        {field === \"dateAdded\"\r\n                          ? \"Date Added\"\r\n                          : field.charAt(0).toUpperCase() + field.slice(1)}\r\n                      </span>\r\n                      {sortField === field && (\r\n                        <span className=\"text-xs\">\r\n                          {sortOrder === \"asc\" ? \"↑\" : \"↓\"}\r\n                        </span>\r\n                      )}\r\n                    </button>\r\n                  ))}\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        {/* Track List – improved cards */}\r\n        <div className=\"px-4 py-4 space-y-2\">\r\n          {filteredTracks.length === 0 ? (\r\n            <div className=\"text-center py-20 text-zinc-500\">\r\n              {searchQuery ? \"No matching songs\" : \"This playlist is empty\"}\r\n            </div>\r\n          ) : (\r\n            filteredTracks.map((track, idx) => {\r\n              const isActive = currentTrack?.id === track.id;\r\n              return (\r\n                <div\r\n                  key={track.id}\r\n                  onClick={() => playTrackAtIndex(idx)}\r\n                  className={`group flex items-center gap-3 p-3 rounded-2xl transition-all cursor-pointer ${\r\n                    isActive\r\n                      ? \"bg-[#E52C2C]/10 border border-[#E52C2C]/30\"\r\n                      : \"bg-zinc-900/50 hover:bg-zinc-800 border border-transparent hover:border-zinc-700\"\r\n                  }`}\r\n                >\r\n                  {/* Cover */}\r\n                  <div className=\"relative w-12 h-12 rounded-xl overflow-hidden bg-zinc-800 flex-shrink-0\">\r\n                    {track.cover ? (\r\n                      <img\r\n                        src={track.cover}\r\n                        alt={track.title}\r\n                        className=\"w-full h-full object-cover\"\r\n                      />\r\n                    ) : (\r\n                      <div className=\"w-full h-full flex items-center justify-center\">\r\n                        <Music2 size={18} />\r\n                      </div>\r\n                    )}\r\n                    {isActive && (\r\n                      <div className=\"absolute inset-0 bg-black/50 flex items-center justify-center\">\r\n                        <Play size={16} className=\"text-white\" fill=\"white\" />\r\n                      </div>\r\n                    )}\r\n                  </div>\r\n\r\n                  {/* Info */}\r\n                  <div className=\"flex-1 min-w-0\">\r\n                    <p\r\n                      className={`font-medium truncate text-sm md:text-base ${isActive ? \"text-[#E52C2C]\" : \"text-white\"}`}\r\n                    >\r\n                      {track.title}\r\n                    </p>\r\n                    <p className=\"text-xs text-zinc-500 truncate\">\r\n                      {track.artist}\r\n                    </p>\r\n                  </div>\r\n\r\n                  {/* Duration + Delete */}\r\n                  <div className=\"flex items-center gap-3\">\r\n                    <span className=\"text-xs text-zinc-500 font-mono\">\r\n                      {formatTime(track.duration)}\r\n                    </span>\r\n                    <button\r\n                      onClick={(e) => {\r\n                        e.stopPropagation();\r\n                        removeTrack(track.id);\r\n                      }}\r\n                      className=\"opacity-0 group-hover:opacity-100 transition text-zinc-500 hover:text-red-400\"\r\n                    >\r\n                      <Trash2 size={16} />\r\n                    </button>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })\r\n          )}\r\n        </div>\r\n      </div>\r\n\r\n      {/* Edit Playlist Name Modal – responsive */}\r\n      {isEditModalOpen && (\r\n        <div className=\"fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] flex items-center justify-center p-4\">\r\n          <div className=\"bg-zinc-950 rounded-2xl max-w-md w-full p-5 border border-zinc-800\">\r\n            <h3 className=\"text-xl font-bold mb-4\">Edit Playlist Name</h3>\r\n            <input\r\n              autoFocus\r\n              value={editName}\r\n              onChange={(e) => setEditName(e.target.value)}\r\n              className=\"w-full h-11 bg-zinc-900 rounded-xl px-4 border border-zinc-800 focus:border-[#E52C2C] outline-none text-sm\"\r\n              onKeyDown={(e) => {\r\n                if (e.key === \"Enter\") {\r\n                  updatePlaylistName(editName);\r\n                  setIsEditModalOpen(false);\r\n                }\r\n              }}\r\n            />\r\n            <div className=\"flex gap-3 mt-5\">\r\n              <button\r\n                onClick={() => setIsEditModalOpen(false)}\r\n                className=\"flex-1 h-10 rounded-xl bg-zinc-800 text-white text-sm\"\r\n              >\r\n                Cancel\r\n              </button>\r\n              <button\r\n                onClick={() => {\r\n                  updatePlaylistName(editName);\r\n                  setIsEditModalOpen(false);\r\n                }}\r\n                className=\"flex-1 h-10 rounded-xl bg-[#E52C2C] text-white text-sm\"\r\n              >\r\n                Save\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n\r\n      {/* Add Songs Modal – improved responsive */}\r\n      {isAddModalOpen && (\r\n        <div className=\"fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] flex items-end sm:items-center justify-center p-4\">\r\n          <div className=\"w-full max-w-lg bg-zinc-950 rounded-2xl border border-zinc-800 max-h-[85vh] flex flex-col animate-in slide-in-from-bottom duration-300\">\r\n            <div className=\"p-4 border-b border-zinc-800\">\r\n              <div className=\"flex items-center justify-between mb-3\">\r\n                <h2 className=\"text-xl font-bold\">Add Songs</h2>\r\n                <button\r\n                  onClick={() => {\r\n                    setIsAddModalOpen(false);\r\n                    setSelectedTracks([]);\r\n                    setAddSearch(\"\");\r\n                  }}\r\n                  className=\"w-8 h-8 rounded-full bg-zinc-800 flex items-center justify-center\"\r\n                >\r\n                  <X size={16} />\r\n                </button>\r\n              </div>\r\n              <div className=\"relative\">\r\n                <Search\r\n                  size={16}\r\n                  className=\"absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500\"\r\n                />\r\n                <input\r\n                  value={addSearch}\r\n                  onChange={(e) => setAddSearch(e.target.value)}\r\n                  placeholder=\"Search songs...\"\r\n                  className=\"w-full h-10 bg-zinc-900 rounded-xl pl-9 pr-4 text-sm border border-zinc-800 focus:border-[#E52C2C] outline-none\"\r\n                />\r\n              </div>\r\n              <div className=\"flex justify-between items-center mt-3\">\r\n                <span className=\"text-xs text-zinc-500\">\r\n                  {selectedTracks.length} selected\r\n                </span>\r\n                <div className=\"flex gap-2\">\r\n                  <button\r\n                    onClick={() =>\r\n                      setSelectedTracks(filteredAvailable.map((t) => t.id))\r\n                    }\r\n                    className=\"text-xs px-2 py-1 rounded bg-zinc-800 text-zinc-300\"\r\n                  >\r\n                    Select all\r\n                  </button>\r\n                  <button\r\n                    onClick={() => setSelectedTracks([])}\r\n                    className=\"text-xs px-2 py-1 rounded bg-zinc-800 text-zinc-300\"\r\n                  >\r\n                    Clear\r\n                  </button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"flex-1 overflow-y-auto p-2 space-y-1\">\r\n              {filteredAvailable.map((track) => {\r\n                const selected = selectedTracks.includes(track.id);\r\n                return (\r\n                  <div\r\n                    key={track.id}\r\n                    onClick={() =>\r\n                      setSelectedTracks((prev) =>\r\n                        prev.includes(track.id)\r\n                          ? prev.filter((id) => id !== track.id)\r\n                          : [...prev, track.id],\r\n                      )\r\n                    }\r\n                    className={`flex items-center gap-3 p-2 rounded-xl cursor-pointer transition ${\r\n                      selected\r\n                        ? \"bg-[#E52C2C]/10 border border-[#E52C2C]/30\"\r\n                        : \"hover:bg-zinc-900\"\r\n                    }`}\r\n                  >\r\n                    <div className=\"w-10 h-10 rounded-lg overflow-hidden bg-zinc-800 flex-shrink-0\">\r\n                      {track.cover ? (\r\n                        <img\r\n                          src={track.cover}\r\n                          alt=\"\"\r\n                          className=\"w-full h-full object-cover\"\r\n                        />\r\n                      ) : (\r\n                        <Music2 size={16} className=\"m-3\" />\r\n                      )}\r\n                    </div>\r\n                    <div className=\"flex-1 min-w-0\">\r\n                      <p className=\"text-sm font-medium truncate\">\r\n                        {track.title}\r\n                      </p>\r\n                      <p className=\"text-xs text-zinc-500 truncate\">\r\n                        {track.artist}\r\n                      </p>\r\n                    </div>\r\n                    <div className=\"text-xs text-zinc-500\">\r\n                      {formatTime(track.duration)}\r\n                    </div>\r\n                    <div\r\n                      className={`w-5 h-5 rounded-full border flex items-center justify-center ${\r\n                        selected\r\n                          ? \"bg-[#E52C2C] border-[#E52C2C]\"\r\n                          : \"border-zinc-600\"\r\n                      }`}\r\n                    >\r\n                      {selected && <Check size={12} className=\"text-white\" />}\r\n                    </div>\r\n                  </div>\r\n                );\r\n              })}\r\n              {filteredAvailable.length === 0 && (\r\n                <div className=\"text-center py-10 text-zinc-500 text-sm\">\r\n                  All songs already in playlist\r\n                </div>\r\n              )}\r\n            </div>\r\n\r\n            <div className=\"p-4 border-t border-zinc-800\">\r\n              <button\r\n                disabled={!selectedTracks.length}\r\n                onClick={addSelectedTracks}\r\n                className=\"w-full h-11 rounded-xl bg-[#E52C2C] text-white font-medium disabled:opacity-40 transition\"\r\n              >\r\n                Add ({selectedTracks.length})\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n"}