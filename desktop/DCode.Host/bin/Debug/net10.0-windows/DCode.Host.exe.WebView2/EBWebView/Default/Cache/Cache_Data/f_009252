{"relativePath":"src\\sections\\DashboardSection.tsx","content":"import {\n  Stat,\n  Table,\n  TableContainer,\n  TableHeader,\n  TableBody,\n  TableRow,\n  TableHead,\n  TableCell,\n  TableCaption,\n  Badge,\n  type BadgeVariant,\n  Button,\n} from \"@dbs-studio/ui\";\nimport { useSettings } from \"../settings/SettingsContext\";\nimport { ViewportFrame } from \"../components/ViewportFrame\";\nimport { FORNECEDORES } from \"../mock/fornecedores\";\nimport { PRODUTOS } from \"../mock/produtos\";\nimport { CLIENTES } from \"../mock/clientes\";\nimport { PEDIDOS, type StatusPedido } from \"../mock/pedidos\";\nimport { Clock, AlertCircle } from \"lucide-react\";\n\nconst formatBRL = (value: number): string =>\n  new Intl.NumberFormat(\"pt-BR\", { style: \"currency\", currency: \"BRL\" }).format(value);\n\nconst STATUS_VARIANT: Record<StatusPedido, BadgeVariant> = {\n  Entregue: \"success\",\n  Pendente: \"warning\",\n  Cancelado: \"destructive\",\n  \"Em andamento\": \"info\",\n};\n\nconst STATUS_LABELS: Record<StatusPedido, string> = {\n  Entregue: \"Entregues\",\n  Pendente: \"Pendentes\",\n  Cancelado: \"Cancelados\",\n  \"Em andamento\": \"Em andamento\",\n};\n\nconst STATUS_COLORS: Record<StatusPedido, string> = {\n  Entregue: \"#22c55e\",\n  Pendente: \"#eab308\",\n  Cancelado: \"#ef4444\",\n  \"Em andamento\": \"#3b82f6\",\n};\n\n// Helper to parse date from dd/mm/yyyy\nconst parseDate = (dateStr: string): Date => {\n  const [day, month, year] = dateStr.split(\"/\").map(Number);\n  return new Date(year, month - 1, day);\n};\n\n// Get month name\nconst getMonthName = (month: number): string => {\n  const names = [\"Jan\", \"Fev\", \"Mar\", \"Abr\", \"Mai\", \"Jun\", \"Jul\", \"Ago\", \"Set\", \"Out\", \"Nov\", \"Dez\"];\n  return names[month];\n};\n\nexport function DashboardSection() {\n  const { settings } = useSettings();\n\n  const totalFornecedores = FORNECEDORES.length;\n  const totalClientes = CLIENTES.length;\n  const totalPedidos = PEDIDOS.length;\n\n  // Calculate revenue metrics\n  const totalRevenue = PEDIDOS.reduce((sum, p) => sum + p.total, 0);\n  const avgOrderValue = totalPedidos > 0 ? totalRevenue / totalPedidos : 0;\n\n  // Monthly revenue (current month)\n  const currentDate = new Date();\n  const currentMonth = currentDate.getMonth();\n  const currentYear = currentDate.getFullYear();\n\n  const currentMonthOrders = PEDIDOS.filter(p => {\n    const date = parseDate(p.data);\n    return date.getMonth() === currentMonth && date.getFullYear() === currentYear;\n  });\n\n  const currentMonthRevenue = currentMonthOrders.reduce((sum, p) => sum + p.total, 0);\n  const currentMonthOrdersCount = currentMonthOrders.length;\n\n  // Previous month revenue\n  const prevMonth = currentMonth === 0 ? 11 : currentMonth - 1;\n  const prevYear = currentMonth === 0 ? currentYear - 1 : currentYear;\n  const prevMonthOrders = PEDIDOS.filter(p => {\n    const date = parseDate(p.data);\n    return date.getMonth() === prevMonth && date.getFullYear() === prevYear;\n  });\n  const prevMonthRevenue = prevMonthOrders.reduce((sum, p) => sum + p.total, 0);\n\n  const revenueChange = prevMonthRevenue > 0 \n    ? ((currentMonthRevenue - prevMonthRevenue) / prevMonthRevenue) * 100 \n    : 0;\n\n  // Order status breakdown\n  const statusCounts: Record<StatusPedido, number> = {\n    Entregue: 0,\n    Pendente: 0,\n    Cancelado: 0,\n    \"Em andamento\": 0,\n  };\n  PEDIDOS.forEach(p => statusCounts[p.status]++);\n\n  // Monthly revenue for last 6 months (for bar chart)\n  const monthlyRevenue: { month: string; revenue: number }[] = [];\n  for (let i = 5; i >= 0; i--) {\n    const m = currentMonth - i;\n    const monthIndex = ((m % 12) + 12) % 12;\n    const year = currentYear - (m < 0 ? 1 : 0);\n    const orders = PEDIDOS.filter(p => {\n      const date = parseDate(p.data);\n      return date.getMonth() === monthIndex && date.getFullYear() === year;\n    });\n    const revenue = orders.reduce((sum, p) => sum + p.total, 0);\n    monthlyRevenue.push({\n      month: getMonthName(monthIndex),\n      revenue: revenue,\n    });\n  }\n\n  const maxRevenue = Math.max(...monthlyRevenue.map(d => d.revenue), 1);\n\n  // Low stock items\n  const lowStockItems = PRODUTOS.filter(p => p.estoque < 50 && p.status === \"Ativo\");\n\n  // Pending orders\n  const pendingOrders = PEDIDOS.filter(p => p.status === \"Pendente\");\n\n  // Recent activity feed\n  const recentActivities = [\n    { id: 1, action: \"Novo pedido #35 criado\", timestamp: \"5 min\", user: \"João Silva\" },\n    { id: 2, action: \"Produto 'Café Gourmet' atualizado\", timestamp: \"18 min\", user: \"Maria Oliveira\" },\n    { id: 3, action: \"Fornecedor 'Metalúrgica Paulista' adicionado\", timestamp: \"1h\", user: \"Carlos Souza\" },\n    { id: 4, action: \"Pedido #28 entregue com sucesso\", timestamp: \"2h\", user: \"Ana Pereira\" },\n    { id: 5, action: \"Cliente 'Supermercados Dias' atualizado\", timestamp: \"3h\", user: \"Roberto Lima\" },\n  ];\n\n  // Get 10 most recent orders\n  const recentOrders = [...PEDIDOS].sort((a, b) => {\n    const aDate = parseDate(a.data);\n    const bDate = parseDate(b.data);\n    return bDate.getTime() - aDate.getTime();\n  }).slice(0, 10);\n\n  return (\n    <div className=\"sections\" style={{ maxWidth: '1400px', margin: '0 auto' }}>\n      {/* Header */}\n      <section className=\"section\" style={{ marginBottom: '32px' }}>\n        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '16px' }}>\n          <div>\n            <h2 className=\"section__title\" style={{ fontSize: '28px', marginBottom: '4px' }}>Dashboard</h2>\n            <p className=\"section__description\" style={{ color: 'var(--muted-foreground)' }}>\n              Visão geral de desempenho e métricas do sistema\n            </p>\n          </div>\n          <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap' }}>\n            <Button size=\"sm\">\n              <Clock size={16} style={{ marginRight: '4px' }} />\n              Este mês\n            </Button>\n            <Button size=\"sm\" variant=\"outline\">\n              Exportar\n            </Button>\n          </div>\n        </div>\n      </section>\n\n      {/* KPI Cards Row */}\n      <div className=\"stat-row\" style={{ marginBottom: '32px' }}>\n        <Stat\n          label=\"Receita do mês\"\n          value={formatBRL(currentMonthRevenue)}\n          trend={revenueChange > 0 ? `+${revenueChange.toFixed(1)}%` : `${revenueChange.toFixed(1)}%`}\n          trendDirection={revenueChange >= 0 ? \"up\" : \"down\"}\n          trendIntent={revenueChange >= 0 ? \"good\" : \"bad\"}\n          hint=\"vs. mês passado\"\n          grow\n        />\n        <Stat\n          label=\"Pedidos\"\n          value={currentMonthOrdersCount.toString()}\n          hint={`${totalPedidos} total`}\n          grow\n        />\n        <Stat\n          label=\"Ticket médio\"\n          value={formatBRL(avgOrderValue)}\n          hint=\"por pedido\"\n          grow\n        />\n        <Stat\n          label=\"Taxa de conclusão\"\n          value={`${totalPedidos > 0 ? ((statusCounts.Entregue / totalPedidos) * 100).toFixed(0) : 0}%`}\n          hint={`${statusCounts.Entregue} entregues`}\n          grow\n        />\n      </div>\n\n      {/* Revenue Chart & Status Distribution */}\n      <div style={{ display: 'grid', gridTemplateColumns: '2fr 1fr', gap: '24px', marginBottom: '32px' }}>\n        {/* Revenue Chart */}\n        <div style={{ \n          padding: '24px', \n          background: 'var(--card-background)', \n          borderRadius: '12px', \n          border: '1px solid var(--border)',\n          boxShadow: '0 1px 3px rgba(0,0,0,0.06)'\n        }}>\n          <h3 style={{ fontSize: '16px', fontWeight: '600', marginBottom: '4px', color: 'var(--foreground)' }}>Receita mensal</h3>\n          <p style={{ fontSize: '14px', color: 'var(--muted-foreground)', marginBottom: '20px' }}>Últimos 6 meses</p>\n          <div style={{ display: 'flex', alignItems: 'flex-end', gap: '16px', height: '160px' }}>\n            {monthlyRevenue.map((data, index) => {\n              const heightPercent = maxRevenue > 0 ? (data.revenue / maxRevenue) * 100 : 0;\n              return (\n                <div key={index} style={{ flex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center', height: '100%' }}>\n                  <div style={{ \n                    width: '100%', \n                    height: `${Math.max(heightPercent, 4)}%`,\n                    background: data.revenue > 0 ? 'var(--primary)' : 'var(--muted)',\n                    borderRadius: '4px 4px 0 0',\n                    minHeight: '8px',\n                    transition: 'height 0.3s ease',\n                    opacity: data.revenue > 0 ? 1 : 0.3\n                  }} />\n                  <span style={{ fontSize: '12px', color: 'var(--muted-foreground)', marginTop: '8px' }}>{data.month}</span>\n                </div>\n              );\n            })}\n          </div>\n          <div style={{ marginTop: '12px', textAlign: 'right', fontSize: '14px', color: 'var(--muted-foreground)' }}>\n            Máximo: {formatBRL(maxRevenue)}\n          </div>\n        </div>\n\n        {/* Status Distribution */}\n        <div style={{ \n          padding: '24px', \n          background: 'var(--card-background)', \n          borderRadius: '12px', \n          border: '1px solid var(--border)',\n          boxShadow: '0 1px 3px rgba(0,0,0,0.06)'\n        }}>\n          <h3 style={{ fontSize: '16px', fontWeight: '600', marginBottom: '16px', color: 'var(--foreground)' }}>Status dos pedidos</h3>\n          {Object.entries(statusCounts).map(([status, count]) => {\n            const percentage = totalPedidos > 0 ? (count / totalPedidos) * 100 : 0;\n            return (\n              <div key={status} style={{ marginBottom: '12px' }}>\n                <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '14px', marginBottom: '4px' }}>\n                  <span style={{ color: 'var(--foreground)' }}>{STATUS_LABELS[status as StatusPedido]}</span>\n                  <span style={{ fontWeight: '600', color: 'var(--foreground)' }}>{count} ({percentage.toFixed(0)}%)</span>\n                </div>\n                <div style={{ width: '100%', height: '8px', background: 'var(--background)', borderRadius: '4px', overflow: 'hidden' }}>\n                  <div style={{ \n                    width: `${percentage}%`, \n                    height: '100%', \n                    background: STATUS_COLORS[status as StatusPedido],\n                    borderRadius: '4px',\n                    transition: 'width 0.5s ease'\n                  }} />\n                </div>\n              </div>\n            );\n          })}\n          <div style={{ marginTop: '16px', paddingTop: '12px', borderTop: '1px solid var(--border)', display: 'flex', justifyContent: 'space-between', fontSize: '14px' }}>\n            <span style={{ color: 'var(--muted-foreground)' }}>Total</span>\n            <span style={{ fontWeight: '600', color: 'var(--foreground)' }}>{totalPedidos} pedidos</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Alerts & Quick Stats */}\n      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '24px', marginBottom: '32px' }}>\n        <div style={{ \n          padding: '20px 24px', \n          background: lowStockItems.length > 0 ? 'rgba(245, 158, 11, 0.1)' : 'var(--card-background)', \n          borderRadius: '12px', \n          border: `1px solid ${lowStockItems.length > 0 ? '#f59e0b' : 'var(--border)'}`,\n          display: 'flex',\n          alignItems: 'center',\n          gap: '16px'\n        }}>\n          <div style={{ \n            width: '48px', \n            height: '48px', \n            borderRadius: '50%', \n            background: lowStockItems.length > 0 ? 'rgba(245, 158, 11, 0.15)' : 'var(--background)',\n            display: 'flex',\n            alignItems: 'center',\n            justifyContent: 'center',\n            flexShrink: 0\n          }}>\n            <AlertCircle size={24} color={lowStockItems.length > 0 ? '#f59e0b' : 'var(--muted-foreground)'} />\n          </div>\n          <div>\n            <div style={{ fontSize: '20px', fontWeight: '700', color: 'var(--foreground)' }}>{lowStockItems.length}</div>\n            <div style={{ fontSize: '14px', color: 'var(--muted-foreground)' }}>\n              {lowStockItems.length > 0 ? 'Produtos com estoque baixo' : 'Todos os produtos com estoque adequado'}\n            </div>\n          </div>\n        </div>\n\n        <div style={{ \n          padding: '20px 24px', \n          background: pendingOrders.length > 0 ? 'rgba(59, 130, 246, 0.1)' : 'var(--card-background)', \n          borderRadius: '12px', \n          border: `1px solid ${pendingOrders.length > 0 ? '#3b82f6' : 'var(--border)'}`,\n          display: 'flex',\n          alignItems: 'center',\n          gap: '16px'\n        }}>\n          <div style={{ \n            width: '48px', \n            height: '48px', \n            borderRadius: '50%', \n            background: pendingOrders.length > 0 ? 'rgba(59, 130, 246, 0.15)' : 'var(--background)',\n            display: 'flex',\n            alignItems: 'center',\n            justifyContent: 'center',\n            flexShrink: 0\n          }}>\n            <Clock size={24} color={pendingOrders.length > 0 ? '#3b82f6' : 'var(--muted-foreground)'} />\n          </div>\n          <div>\n            <div style={{ fontSize: '20px', fontWeight: '700', color: 'var(--foreground)' }}>{pendingOrders.length}</div>\n            <div style={{ fontSize: '14px', color: 'var(--muted-foreground)' }}>\n              {pendingOrders.length > 0 ? 'Pedidos aguardando aprovação' : 'Nenhum pedido pendente'}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Recent Orders Table */}\n      <section className=\"section\" style={{ marginBottom: '32px' }}>\n        <h2 className=\"section__title\">Pedidos recentes</h2>\n        <p className=\"section__description\">Últimos 10 pedidos realizados</p>\n        <ViewportFrame\n          preset={settings.viewport}\n          customWidth={settings.customWidth}\n          title=\"Pedidos recentes\"\n        >\n          <TableContainer>\n            <Table>\n              <TableCaption>Lista dos 10 pedidos mais recentes</TableCaption>\n              <TableHeader>\n                <TableRow>\n                  <TableHead>ID</TableHead>\n                  <TableHead>Cliente</TableHead>\n                  <TableHead>Data</TableHead>\n                  <TableHead>Status</TableHead>\n                  <TableHead className=\"ui-table__head-cell--right\">Total</TableHead>\n                </TableRow>\n              </TableHeader>\n              <TableBody>\n                {recentOrders.map((pedido) => {\n                  const cliente = CLIENTES.find((c) => c.id === pedido.clienteId);\n                  return (\n                    <TableRow key={pedido.id}>\n                      <TableCell>#{pedido.id}</TableCell>\n                      <TableCell>{cliente?.fantasia || \"N/A\"}</TableCell>\n                      <TableCell>{pedido.data}</TableCell>\n                      <TableCell>\n                        <Badge variant={STATUS_VARIANT[pedido.status]}>\n                          {pedido.status}\n                        </Badge>\n                      </TableCell>\n                      <TableCell className=\"ui-table__cell--right\">\n                        {formatBRL(pedido.total)}\n                      </TableCell>\n                    </TableRow>\n                  );\n                })}\n              </TableBody>\n            </Table>\n          </TableContainer>\n        </ViewportFrame>\n      </section>\n\n      {/* Activity Timeline & Stats */}\n      <div style={{ display: 'grid', gridTemplateColumns: '2fr 1fr', gap: '24px' }}>\n        {/* Activity Feed */}\n        <div style={{ \n          padding: '24px', \n          background: 'var(--card-background)', \n          borderRadius: '12px', \n          border: '1px solid var(--border)',\n          boxShadow: '0 1px 3px rgba(0,0,0,0.06)'\n        }}>\n          <h3 style={{ fontSize: '16px', fontWeight: '600', marginBottom: '16px', color: 'var(--foreground)' }}>Atividade recente</h3>\n          {recentActivities.map((activity) => (\n            <div key={activity.id} style={{ \n              padding: '12px 0', \n              borderBottom: '1px solid var(--border)', \n              display: 'flex', \n              justifyContent: 'space-between', \n              alignItems: 'center',\n              gap: '12px'\n            }}>\n              <div style={{ flex: 1 }}>\n                <div style={{ fontWeight: '500', fontSize: '14px', color: 'var(--foreground)' }}>{activity.action}</div>\n                <div style={{ fontSize: '12px', color: 'var(--muted-foreground)' }}>por {activity.user}</div>\n              </div>\n              <span style={{ fontSize: '12px', color: 'var(--muted-foreground)', whiteSpace: 'nowrap' }}>{activity.timestamp}</span>\n            </div>\n          ))}\n        </div>\n\n        {/* Quick Stats */}\n        <div style={{ \n          padding: '24px', \n          background: 'var(--card-background)', \n          borderRadius: '12px', \n          border: '1px solid var(--border)',\n          boxShadow: '0 1px 3px rgba(0,0,0,0.06)',\n          display: 'flex',\n          flexDirection: 'column',\n          gap: '16px'\n        }}>\n          <h3 style={{ fontSize: '16px', fontWeight: '600', color: 'var(--foreground)' }}>Resumo rápido</h3>\n          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '12px' }}>\n            <div style={{ padding: '12px', background: 'var(--background)', borderRadius: '8px' }}>\n              <div style={{ fontSize: '12px', color: 'var(--muted-foreground)' }}>Fornecedores</div>\n              <div style={{ fontSize: '24px', fontWeight: '700', color: 'var(--foreground)' }}>{totalFornecedores}</div>\n            </div>\n            <div style={{ padding: '12px', background: 'var(--background)', borderRadius: '8px' }}>\n              <div style={{ fontSize: '12px', color: 'var(--muted-foreground)' }}>Produtos</div>\n              <div style={{ fontSize: '24px', fontWeight: '700', color: 'var(--foreground)' }}>{PRODUTOS.length}</div>\n            </div>\n            <div style={{ padding: '12px', background: 'var(--background)', borderRadius: '8px' }}>\n              <div style={{ fontSize: '12px', color: 'var(--muted-foreground)' }}>Clientes</div>\n              <div style={{ fontSize: '24px', fontWeight: '700', color: 'var(--foreground)' }}>{totalClientes}</div>\n            </div>\n            <div style={{ padding: '12px', background: 'var(--background)', borderRadius: '8px' }}>\n              <div style={{ fontSize: '12px', color: 'var(--muted-foreground)' }}>Pedidos</div>\n              <div style={{ fontSize: '24px', fontWeight: '700', color: 'var(--foreground)' }}>{totalPedidos}</div>\n            </div>\n          </div>\n          <div style={{ paddingTop: '12px', borderTop: '1px solid var(--border)' }}>\n            <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '14px' }}>\n              <span style={{ color: 'var(--muted-foreground)' }}>Receita total</span>\n              <span style={{ fontWeight: '600', color: 'var(--foreground)' }}>{formatBRL(totalRevenue)}</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"}