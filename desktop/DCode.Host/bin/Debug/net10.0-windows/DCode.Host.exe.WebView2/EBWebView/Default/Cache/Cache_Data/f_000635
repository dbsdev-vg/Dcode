{"relativePath":"src\\app\\profile\\page.tsx","content":"//app/profile/page.tsx\r\n\r\n\"use client\";\r\n\r\nimport { useState, useEffect, useMemo } from \"react\";\r\nimport { useUserStore } from \"@/modules/user/user.store\";\r\nimport SignInButton from \"@/components/network/SignInButton\";\r\nimport SignOutButton from \"@/components/network/SignOutButton\";\r\nimport Image from \"next/image\";\r\nimport { useLibraryStore } from \"@/modules/library/library.store\";\r\nimport { db } from \"@/modules/db/db\";\r\nimport {\r\n  CloudUpload,\r\n  CloudOff,\r\n  Database,\r\n  Clock,\r\n  Music2,\r\n  ListMusic,\r\n  HardDrive,\r\n  Trash2,\r\n  AlertTriangle,\r\n  X,\r\n  CheckCircle,\r\n} from \"lucide-react\";\r\n\r\n// Helper: format bytes\r\nfunction formatBytes(bytes: number, decimals = 2) {\r\n  if (bytes === 0) return \"0 Bytes\";\r\n  const k = 1024;\r\n  const dm = decimals < 0 ? 0 : decimals;\r\n  const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\"];\r\n  const i = Math.floor(Math.log(bytes) / Math.log(k));\r\n  return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\r\n}\r\n\r\nexport default function ProfilePage() {\r\n  const user = useUserStore((s) => s.user);\r\n  const tracks = useLibraryStore((state) => state.tracks);\r\n  const [playlistsCount, setPlaylistsCount] = useState(0);\r\n  const [isSyncing, setIsSyncing] = useState(false);\r\n  const [lastSync, setLastSync] = useState<Date | null>(null);\r\n  const [syncStatus, setSyncStatus] = useState<\"idle\" | \"success\" | \"error\">(\"idle\");\r\n  const [showStorageModal, setShowStorageModal] = useState(false);\r\n  const [selectedTrackForDeletion, setSelectedTrackForDeletion] = useState<string | null>(null);\r\n\r\n  // Load playlists count\r\n  useEffect(() => {\r\n    db.playlists.count().then(setPlaylistsCount);\r\n  }, []);\r\n\r\n  // Calculate total storage used (sum of track.size)\r\n  const totalUsedBytes = useMemo(() => {\r\n    return tracks.reduce((total, track) => total + (track.size || 0), 0);\r\n  }, [tracks]);\r\n\r\n  // Example: pretend we have a 2 GB quota (in practice, could be cloud storage limit)\r\n  const quotaBytes = 2 * 1024 * 1024 * 1024; // 2 GB\r\n  const freeBytes = quotaBytes - totalUsedBytes;\r\n  const usedPercentage = (totalUsedBytes / quotaBytes) * 100;\r\n\r\n  // Total duration\r\n  const totalDuration = useMemo(() => {\r\n    const sum = tracks.reduce((acc, t) => acc + (t.duration || 0), 0);\r\n    const hours = Math.floor(sum / 3600);\r\n    const minutes = Math.floor((sum % 3600) / 60);\r\n    if (hours > 0) return `${hours}h ${minutes}m`;\r\n    return `${minutes}m`;\r\n  }, [tracks]);\r\n\r\n  // Sync mock\r\n  const handleSync = async () => {\r\n    if (!user) return;\r\n    setIsSyncing(true);\r\n    setSyncStatus(\"idle\");\r\n    try {\r\n      await new Promise((resolve) => setTimeout(resolve, 1500));\r\n      setLastSync(new Date());\r\n      setSyncStatus(\"success\");\r\n    } catch {\r\n      setSyncStatus(\"error\");\r\n    } finally {\r\n      setIsSyncing(false);\r\n    }\r\n  };\r\n\r\n  // Delete a track (and remove from playlists)\r\n  const deleteTrack = async (trackId: string) => {\r\n    try {\r\n      await db.tracks.delete(trackId);\r\n      // Also remove from all playlists\r\n      const playlists = await db.playlists.toArray();\r\n      for (const playlist of playlists) {\r\n        if (playlist.trackIds.includes(trackId)) {\r\n          const newTrackIds = playlist.trackIds.filter((id) => id !== trackId);\r\n          await db.playlists.update(playlist.id, { trackIds: newTrackIds, updatedAt: Date.now() });\r\n        }\r\n      }\r\n      setSelectedTrackForDeletion(null);\r\n    } catch (error) {\r\n      console.error(\"Failed to delete track\", error);\r\n    }\r\n  };\r\n\r\n  if (!user) {\r\n    return (\r\n      <div className=\"min-h-screen bg-black flex items-center justify-center p-4\">\r\n        <div className=\"text-center max-w-md w-full\">\r\n          <div className=\"w-20 h-20 mx-auto bg-zinc-900 rounded-full flex items-center justify-center mb-4\">\r\n            <Music2 size={32} className=\"text-[#E52C2C]\" />\r\n          </div>\r\n          <h1 className=\"text-2xl font-bold\">Profile</h1>\r\n          <p className=\"text-zinc-400 mt-2\">Sign in to enable cloud sync and access your library anywhere.</p>\r\n          <div className=\"mt-6\">\r\n            <SignInButton />\r\n          </div>\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div className=\"min-h-screen bg-black pb-32 w-full max-w-[100vw] overflow-x-hidden\">\r\n      <div className=\"max-w-[800px] mx-auto w-full px-4 py-6\">\r\n        {/* Profile header */}\r\n        <div className=\"flex flex-col items-center mb-8\">\r\n          {user.picture && (\r\n            <Image\r\n              src={user.picture}\r\n              alt={user.name}\r\n              width={96}\r\n              height={96}\r\n              className=\"rounded-full border-2 border-[#E52C2C] shadow-lg\"\r\n            />\r\n          )}\r\n          <h1 className=\"text-2xl font-bold mt-4\">{user.name}</h1>\r\n          <p className=\"text-zinc-400 text-sm\">{user.email}</p>\r\n        </div>\r\n\r\n        {/* Stats grid */}\r\n        <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6\">\r\n          <StatCard icon={<Music2 size={18} />} label=\"Tracks\" value={tracks.length} />\r\n          <StatCard icon={<ListMusic size={18} />} label=\"Playlists\" value={playlistsCount} />\r\n          <StatCard icon={<Clock size={18} />} label=\"Total time\" value={totalDuration} />\r\n          <StatCard\r\n            icon={<HardDrive size={18} />}\r\n            label=\"Storage used\"\r\n            value={formatBytes(totalUsedBytes)}\r\n            subtext={`of ${formatBytes(quotaBytes)}`}\r\n            onClick={() => setShowStorageModal(true)}\r\n            clickable\r\n          />\r\n        </div>\r\n\r\n        {/* Storage usage bar (clickable to open details) */}\r\n        <div\r\n          className=\"mb-6 cursor-pointer hover:bg-zinc-900/30 rounded-xl transition p-1\"\r\n          onClick={() => setShowStorageModal(true)}\r\n        >\r\n          <div className=\"flex justify-between text-xs text-zinc-500 mb-1\">\r\n            <span>Library storage</span>\r\n            <span>{usedPercentage.toFixed(1)}% used</span>\r\n          </div>\r\n          <div className=\"w-full h-2 bg-zinc-800 rounded-full overflow-hidden\">\r\n            <div\r\n              className=\"h-full bg-gradient-to-r from-[#E52C2C] to-[#a20707] rounded-full transition-all duration-300\"\r\n              style={{ width: `${Math.min(usedPercentage, 100)}%` }}\r\n            />\r\n          </div>\r\n          <p className=\"text-[11px] text-zinc-600 mt-1\">\r\n            {formatBytes(totalUsedBytes)} of {formatBytes(quotaBytes)} used\r\n          </p>\r\n        </div>\r\n\r\n        {/* Low space warning */}\r\n        {freeBytes < 0.1 * quotaBytes && (\r\n          <div className=\"mb-5 bg-yellow-500/10 border border-yellow-500/30 rounded-xl p-3 flex items-center gap-3\">\r\n            <AlertTriangle size={20} className=\"text-yellow-500 flex-shrink-0\" />\r\n            <div className=\"flex-1\">\r\n              <p className=\"text-sm font-medium text-yellow-500\">Storage almost full</p>\r\n              <p className=\"text-xs text-zinc-400\">\r\n                Delete some tracks or upgrade your plan to free up space.\r\n              </p>\r\n            </div>\r\n          </div>\r\n        )}\r\n\r\n        {/* Cloud sync card */}\r\n        <div className=\"bg-zinc-900/70 rounded-2xl border border-zinc-800 p-5 mb-5\">\r\n          <div className=\"flex items-start justify-between\">\r\n            <div className=\"flex items-center gap-3\">\r\n              <div className=\"w-10 h-10 rounded-xl bg-[#E52C2C]/10 flex items-center justify-center\">\r\n                <CloudUpload size={20} className=\"text-[#E52C2C]\" />\r\n              </div>\r\n              <div>\r\n                <h2 className=\"font-semibold\">Cloud Sync</h2>\r\n                <p className=\"text-xs text-zinc-500\">Backed up to Google Drive</p>\r\n              </div>\r\n            </div>\r\n            <div className=\"text-right\">\r\n              <div className=\"flex items-center gap-1 text-xs\">\r\n                <span className=\"text-zinc-500\">Status:</span>\r\n                <span\r\n                  className={\r\n                    syncStatus === \"success\"\r\n                      ? \"text-green-400\"\r\n                      : syncStatus === \"error\"\r\n                      ? \"text-red-400\"\r\n                      : \"text-yellow-400\"\r\n                  }\r\n                >\r\n                  {syncStatus === \"success\" ? \"Synced\" : syncStatus === \"error\" ? \"Failed\" : \"Ready\"}\r\n                </span>\r\n              </div>\r\n              {lastSync && (\r\n                <div className=\"text-[11px] text-zinc-600 mt-1\">\r\n                  Last sync: {lastSync.toLocaleTimeString()}\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n          <div className=\"mt-4\">\r\n            <button\r\n              onClick={handleSync}\r\n              disabled={isSyncing}\r\n              className=\"w-full h-10 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white text-sm font-medium transition disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2\"\r\n            >\r\n              {isSyncing ? (\r\n                <>\r\n                  <div className=\"w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\r\n                  Syncing...\r\n                </>\r\n              ) : (\r\n                <>\r\n                  <CloudUpload size={16} />\r\n                  Sync now\r\n                </>\r\n              )}\r\n            </button>\r\n          </div>\r\n        </div>\r\n\r\n        {/* Account actions */}\r\n        <div className=\"space-y-3\">\r\n          <button className=\"w-full h-12 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-white text-sm font-medium transition flex items-center justify-center gap-2\">\r\n            Edit Profile\r\n          </button>\r\n          <SignOutButton />\r\n        </div>\r\n\r\n        <div className=\"text-center text-[11px] text-zinc-700 mt-8\">Apollo Hub v3.0.1</div>\r\n      </div>\r\n\r\n      {/* Storage details modal */}\r\n      {showStorageModal && (\r\n        <div className=\"fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] flex items-center justify-center p-4\">\r\n          <div className=\"bg-zinc-950 rounded-2xl max-w-lg w-full max-h-[80vh] flex flex-col border border-zinc-800\">\r\n            <div className=\"flex items-center justify-between p-5 border-b border-zinc-800\">\r\n              <div className=\"flex items-center gap-2\">\r\n                <HardDrive size={20} className=\"text-[#E52C2C]\" />\r\n                <h2 className=\"text-xl font-bold\">Storage Management</h2>\r\n              </div>\r\n              <button onClick={() => setShowStorageModal(false)} className=\"text-zinc-500 hover:text-white\">\r\n                <X size={20} />\r\n              </button>\r\n            </div>\r\n\r\n            <div className=\"flex-1 overflow-y-auto p-5 space-y-5\">\r\n              {/* Storage summary */}\r\n              <div className=\"bg-zinc-900/50 rounded-xl p-4\">\r\n                <div className=\"flex justify-between mb-2 text-sm\">\r\n                  <span className=\"text-zinc-400\">Used space</span>\r\n                  <span className=\"font-mono text-white\">{formatBytes(totalUsedBytes)}</span>\r\n                </div>\r\n                <div className=\"flex justify-between text-sm\">\r\n                  <span className=\"text-zinc-400\">Quota</span>\r\n                  <span className=\"font-mono text-white\">{formatBytes(quotaBytes)}</span>\r\n                </div>\r\n                <div className=\"mt-3 h-2 bg-zinc-800 rounded-full overflow-hidden\">\r\n                  <div\r\n                    className=\"h-full bg-[#E52C2C] rounded-full\"\r\n                    style={{ width: `${Math.min(usedPercentage, 100)}%` }}\r\n                  />\r\n                </div>\r\n              </div>\r\n\r\n              {/* Top large files */}\r\n              <div>\r\n                <h3 className=\"font-semibold mb-2\">Largest files</h3>\r\n                <div className=\"space-y-2\">\r\n                  {tracks\r\n                    .filter((t) => t.size)\r\n                    .sort((a, b) => (b.size || 0) - (a.size || 0))\r\n                    .slice(0, 5)\r\n                    .map((track) => (\r\n                      <div\r\n                        key={track.id}\r\n                        className=\"flex items-center justify-between p-2 rounded-lg bg-zinc-900/30 border border-zinc-800\"\r\n                      >\r\n                        <div className=\"min-w-0 flex-1\">\r\n                          <p className=\"text-sm font-medium truncate\">{track.title}</p>\r\n                          <p className=\"text-xs text-zinc-500 truncate\">{track.artist}</p>\r\n                        </div>\r\n                        <div className=\"flex items-center gap-3\">\r\n                          <span className=\"text-xs text-zinc-400 font-mono\">\r\n                            {formatBytes(track.size || 0)}\r\n                          </span>\r\n                          <button\r\n                            onClick={() => setSelectedTrackForDeletion(track.id)}\r\n                            className=\"p-1.5 rounded-lg hover:bg-red-500/20 text-red-400 transition\"\r\n                          >\r\n                            <Trash2 size={14} />\r\n                          </button>\r\n                        </div>\r\n                      </div>\r\n                    ))}\r\n                  {tracks.filter((t) => t.size).length === 0 && (\r\n                    <p className=\"text-sm text-zinc-500 text-center py-4\">No files with size info</p>\r\n                  )}\r\n                </div>\r\n              </div>\r\n\r\n              {/* Storage tips */}\r\n              <div className=\"bg-zinc-900/30 rounded-xl p-4\">\r\n                <h3 className=\"font-semibold text-sm mb-2\">\uD83D\uDCA1 Free up space</h3>\r\n                <ul className=\"text-xs text-zinc-400 space-y-1 list-disc list-inside\">\r\n                  <li>Delete unused tracks from your library</li>\r\n                  <li>Clear cached album art (not stored in quota)</li>\r\n                  <li>Sync to cloud and remove local copies (coming soon)</li>\r\n                </ul>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"p-5 border-t border-zinc-800\">\r\n              <button\r\n                onClick={() => setShowStorageModal(false)}\r\n                className=\"w-full h-10 rounded-xl bg-zinc-800 text-white\"\r\n              >\r\n                Close\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n\r\n      {/* Delete confirmation modal */}\r\n      {selectedTrackForDeletion && (\r\n        <div className=\"fixed inset-0 bg-black/80 backdrop-blur-sm z-[101] flex items-center justify-center p-4\">\r\n          <div className=\"bg-zinc-950 rounded-2xl max-w-sm w-full p-5 border border-zinc-800\">\r\n            <h3 className=\"text-lg font-bold mb-2\">Delete track?</h3>\r\n            <p className=\"text-sm text-zinc-400 mb-5\">\r\n              This will permanently remove the track from your library and all playlists.\r\n            </p>\r\n            <div className=\"flex gap-3\">\r\n              <button\r\n                onClick={() => setSelectedTrackForDeletion(null)}\r\n                className=\"flex-1 h-10 rounded-xl bg-zinc-800 text-white\"\r\n              >\r\n                Cancel\r\n              </button>\r\n              <button\r\n                onClick={() => deleteTrack(selectedTrackForDeletion)}\r\n                className=\"flex-1 h-10 rounded-xl bg-red-600 text-white\"\r\n              >\r\n                Delete\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n\r\n// StatCard component (unchanged but added clickable)\r\nfunction StatCard({\r\n  icon,\r\n  label,\r\n  value,\r\n  subtext,\r\n  onClick,\r\n  clickable = false,\r\n}: {\r\n  icon: React.ReactNode;\r\n  label: string;\r\n  value: string | number;\r\n  subtext?: string;\r\n  onClick?: () => void;\r\n  clickable?: boolean;\r\n}) {\r\n  return (\r\n    <div\r\n      onClick={onClick}\r\n      className={`bg-zinc-900/50 rounded-xl p-3 text-center border border-zinc-800 ${\r\n        clickable ? \"cursor-pointer hover:bg-zinc-800/70 transition\" : \"\"\r\n      }`}\r\n    >\r\n      <div className=\"text-[#E52C2C] flex justify-center mb-1\">{icon}</div>\r\n      <div className=\"text-xl font-bold\">{value}</div>\r\n      <div className=\"text-[11px] text-zinc-500\">{label}</div>\r\n      {subtext && <div className=\"text-[10px] text-zinc-600 mt-0.5\">{subtext}</div>}\r\n    </div>\r\n  );\r\n}"}