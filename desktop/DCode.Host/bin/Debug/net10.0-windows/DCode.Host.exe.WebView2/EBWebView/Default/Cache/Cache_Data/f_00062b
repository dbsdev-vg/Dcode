{"relativePath":"frontend\\src\\components\\dcode\\files-view.tsx","content":"\"use client\";\n\nimport Editor, {\n  type BeforeMount,\n  type OnValidate,\n  useMonaco,\n} from \"@monaco-editor/react\";\nimport {\n  ChevronDown,\n  ChevronRight,\n  Braces,\n  ArrowLeft,\n  Code2,\n  Database,\n  File,\n  FileCode2,\n  FileJson,\n  FileText,\n  Folder,\n  FolderOpen,\n  FolderGit2,\n  MoreHorizontal,\n  MessageSquare,\n  PanelLeft,\n  Play,\n  Save,\n  Settings,\n  TriangleAlert,\n  TerminalSquare,\n  X,\n} from \"lucide-react\";\nimport { Button, IconButton } from \"@dbs-studio/ui\";\n\nimport { useCallback, useEffect, useRef, useState } from \"react\";\nimport { useProject } from \"../../state/project-context\";\nimport { DCodeLogo } from \"../brand/dcode-logo\";\nimport { useWorkspace } from \"../../state/workspace-context\";\n\r\nimport type {\n  ProjectTreeNode,\n} from \"../../types/dcode\";\n\ninterface EditorTab {\n  relativePath: string;\n  name: string;\n  content: string;\n  savedContent: string;\n  loading: boolean;\n  error: string | null;\n}\n\ninterface ProjectFileResponse {\n  relativePath: string;\n  content: string;\n}\n\ninterface RegisteredProject {\n  id: string;\n  name: string;\n  path: string;\n}\n\ninterface ProjectSessionResponse {\n  projectId: string;\n  activeFilePath: string | null;\n  openTabs: string[];\n  expandedFolders: string[];\n  layout: {\n    explorerOpen: boolean;\n    chatOpen: boolean;\n    terminalOpen: boolean;\n  };\n}\n\nconst serverUrl = \"http://localhost:5283\";\nconst diagnosticExtensions = new Set([\n  \"js\",\n  \"jsx\",\n  \"json\",\n  \"ts\",\n  \"tsx\",\n]);\n\nconst configureMonaco: BeforeMount = (monaco) => {\n  const compilerOptions = {\n    allowJs: true,\n    allowNonTsExtensions: true,\n    allowSyntheticDefaultImports: true,\n    esModuleInterop: true,\n    jsx: monaco.languages.typescript.JsxEmit.ReactJSX,\n    module: monaco.languages.typescript.ModuleKind.ESNext,\n    moduleResolution:\n      monaco.languages.typescript.ModuleResolutionKind.NodeJs,\n    resolveJsonModule: true,\n    target: monaco.languages.typescript.ScriptTarget.ESNext,\n  };\n\n  monaco.languages.typescript.typescriptDefaults.setCompilerOptions(\n    compilerOptions,\n  );\n  monaco.languages.typescript.javascriptDefaults.setCompilerOptions(\n    compilerOptions,\n  );\n\n  const diagnosticsOptions = {\n    noSemanticValidation: true,\n    noSyntaxValidation: false,\n    diagnosticCodesToIgnore: [2307, 2503, 2792, 2875],\n  };\n\n  monaco.languages.typescript.typescriptDefaults.setDiagnosticsOptions(\n    diagnosticsOptions,\n  );\n  monaco.languages.typescript.javascriptDefaults.setDiagnosticsOptions(\n    diagnosticsOptions,\n  );\n};\n\nasync function registerProject(path: string): Promise<RegisteredProject> {\n  const response = await fetch(`${serverUrl}/api/projects/open`, {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ path }),\n  });\n\n  if (!response.ok) {\n    throw new Error(`Unable to register project (HTTP ${response.status})`);\n  }\n\n  return await response.json() as RegisteredProject;\n}\n\r\nexport function FilesView() {\n  const { activeProject } = useProject();\n  const { setActiveWorkspace } = useWorkspace();\n  const monaco = useMonaco();\n\r\n  const [tree, setTree] =\r\n    useState<ProjectTreeNode[]>([]);\r\n\r\n  const [loading, setLoading] =\r\n    useState(false);\r\n\r\n  const [error, setError] =\n    useState<string | null>(null);\n\n  const [tabs, setTabs] = useState<EditorTab[]>([]);\n  const [activePath, setActivePath] = useState<string | null>(null);\n  const [savingPath, setSavingPath] = useState<string | null>(null);\n  const [fileErrors, setFileErrors] = useState<Record<string, number>>({});\n  const [explorerOpen, setExplorerOpen] = useState(true);\n  const [chatOpen, setChatOpen] = useState(false);\n  const [terminalOpen, setTerminalOpen] = useState(false);\n  const [expandedFolders, setExpandedFolders] = useState<Set<string>>(\n    () => new Set(),\n  );\n  const sessionTabPaths = tabs\n    .map((tab) => tab.relativePath)\n    .join(\"\\u0000\");\n  const registeredProjectId = useRef<string | null>(null);\n  const sessionReady = useRef(false);\n  const tabsRef = useRef(tabs);\n  tabsRef.current = tabs;\n\r\n  useEffect(() => {\n    if (!activeProject) {\n      return;\n    }\r\n\r\n    const project = activeProject;\r\n\r\n    async function loadTree() {\r\n      setLoading(true);\r\n      setError(null);\n\n      try {\n        const registeredProject = await registerProject(project.path);\n        registeredProjectId.current = registeredProject.id;\n        const [response, sessionResponse] = await Promise.all([\n          fetch(`${serverUrl}/api/projects/${registeredProject.id}/tree`),\n          fetch(`${serverUrl}/api/projects/${registeredProject.id}/session`),\n        ]);\n\r\n        if (!response.ok) {\r\n          throw new Error(`HTTP ${response.status}`);\r\n        }\r\n\r\n        const data: ProjectTreeNode[] =\r\n          await response.json();\r\n\r\n        setTree(data);\n\n        if (sessionResponse.ok) {\n          const session = await sessionResponse.json() as ProjectSessionResponse;\n          const restoredTabs: Array<EditorTab | null> = await Promise.all(\n            session.openTabs.map(async (relativePath) => {\n              const query = new URLSearchParams({ path: relativePath });\n              const fileResponse = await fetch(\n                `${serverUrl}/api/projects/${registeredProject.id}/file?${query}`,\n              );\n\n              if (!fileResponse.ok) {\n                return null;\n              }\n\n              const file = await fileResponse.json() as ProjectFileResponse;\n              return {\n                relativePath,\n                name: getFileName(relativePath),\n                content: file.content,\n                savedContent: file.content,\n                loading: false,\n                error: null,\n              };\n            }),\n          );\n          const availableTabs = restoredTabs.filter(\n            (tab): tab is EditorTab => tab !== null,\n          );\n\n          setTabs(availableTabs);\n          setActivePath(\n            availableTabs.some(\n              (tab) => tab.relativePath === session.activeFilePath,\n            )\n              ? session.activeFilePath\n              : availableTabs[0]?.relativePath ?? null,\n          );\n          setExpandedFolders(new Set(session.expandedFolders));\n          setExplorerOpen(session.layout.explorerOpen);\n          setChatOpen(session.layout.chatOpen);\n          setTerminalOpen(session.layout.terminalOpen);\n        }\n\n        sessionReady.current = true;\n      } catch (error) {\r\n        setError(\r\n          error instanceof Error\r\n            ? error.message\r\n            : \"Failed to load project\",\r\n        );\r\n      } finally {\r\n        setLoading(false);\r\n      }\r\n    }\r\n\r\n    sessionReady.current = false;\n    void loadTree();\n  }, [activeProject]);\n\n  useEffect(() => {\n    if (!activeProject) {\n      return;\n    }\n\n    const project = activeProject;\n\n    async function refreshTree() {\n      try {\n        const registered = await registerProject(project.path);\n        registeredProjectId.current = registered.id;\n        const response = await fetch(\n          `${serverUrl}/api/projects/${registered.id}/tree`,\n        );\n\n        if (response.ok) {\n          const refreshedTree = await response.json() as ProjectTreeNode[];\n          setTree((current) => (\n            JSON.stringify(current) === JSON.stringify(refreshedTree)\n              ? current\n              : refreshedTree\n          ));\n        }\n      } catch {\n        // A temporary refresh failure must not remove the visible tree.\n      }\n    }\n\n    const interval = window.setInterval(() => void refreshTree(), 3000);\n    return () => window.clearInterval(interval);\n  }, [activeProject]);\n\n  useEffect(() => {\n    if (!activeProject || !sessionReady.current) {\n      return;\n    }\n\n    const timeout = window.setTimeout(async () => {\n      try {\n        const projectId = registeredProjectId.current\n          ?? (await registerProject(activeProject.path)).id;\n        registeredProjectId.current = projectId;\n\n        await fetch(`${serverUrl}/api/projects/${projectId}/session`, {\n          method: \"PUT\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({\n            activeFilePath: activePath,\n            openTabs: sessionTabPaths\n              ? sessionTabPaths.split(\"\\u0000\")\n              : [],\n            expandedFolders: [...expandedFolders],\n            layout: { explorerOpen, chatOpen, terminalOpen },\n          }),\n        });\n      } catch {\n        // Session persistence is best effort while the server is unavailable.\n      }\n    }, 400);\n\n    return () => window.clearTimeout(timeout);\n  }, [\n    activePath,\n    activeProject,\n    chatOpen,\n    expandedFolders,\n    explorerOpen,\n    sessionTabPaths,\n    terminalOpen,\n  ]);\n\n  useEffect(() => {\n    if (!activeProject) {\n      return;\n    }\n\n    const project = activeProject;\n\n    async function refreshOpenFiles() {\n      const openTabs = tabsRef.current;\n\n      if (openTabs.length === 0) {\n        return;\n      }\n\n      try {\n        const registered = await registerProject(project.path);\n        registeredProjectId.current = registered.id;\n\n        await Promise.all(openTabs.map(async (tab) => {\n          const query = new URLSearchParams({ path: tab.relativePath });\n          const response = await fetch(\n            `${serverUrl}/api/projects/${registered.id}/file?${query}`,\n          );\n\n          if (!response.ok) {\n            return;\n          }\n\n          const file = await response.json() as ProjectFileResponse;\n\n          setTabs((current) => current.map((item) => {\n            if (\n              item.relativePath !== tab.relativePath\n              || file.content === item.savedContent\n            ) {\n              return item;\n            }\n\n            if (item.content === item.savedContent) {\n              return {\n                ...item,\n                content: file.content,\n                savedContent: file.content,\n                error: null,\n              };\n            }\n\n            return {\n              ...item,\n              error: \"This file changed on disk. Close and reopen it before saving.\",\n            };\n          }));\n        }));\n      } catch {\n        // Keep the current editor contents during temporary server failures.\n      }\n    }\n\n    const interval = window.setInterval(\n      () => void refreshOpenFiles(),\n      2000,\n    );\n    return () => window.clearInterval(interval);\n  }, [activeProject]);\n\n  useEffect(() => {\n    if (!monaco || !activeProject || tree.length === 0) {\n      return;\n    }\n\n    const editorApi = monaco;\n    const project = activeProject;\n\n    configureMonaco(editorApi);\n\n    let cancelled = false;\n    const createdModels: { dispose: () => void }[] = [];\n    const pathByModel = new Map<string, string>();\n\n    const markerSubscription = editorApi.editor.onDidChangeMarkers((resources) => {\n      setFileErrors((current) => {\n        const next = { ...current };\n\n        for (const resource of resources) {\n          const relativePath = pathByModel.get(resource.toString());\n\n          if (!relativePath) {\n            continue;\n          }\n\n          const errorCount = editorApi.editor\n            .getModelMarkers({ resource })\n            .filter((marker) => (\n              marker.severity === editorApi.MarkerSeverity.Error\n            )).length;\n\n          if (errorCount > 0) {\n            next[relativePath] = errorCount;\n          } else {\n            delete next[relativePath];\n          }\n        }\n\n        return next;\n      });\n    });\n\n    async function indexProject() {\n      try {\n        const registeredProject = await registerProject(project.path);\n        const sourceFiles = collectDiagnosticFiles(tree);\n\n        for (let index = 0; index < sourceFiles.length; index += 8) {\n          const batch = sourceFiles.slice(index, index + 8);\n\n          await Promise.all(batch.map(async (node) => {\n            const modelUri = editorApi.Uri.parse(\n              getMonacoModelPath(node.relativePath),\n            );\n            pathByModel.set(modelUri.toString(), node.relativePath);\n\n            if (editorApi.editor.getModel(modelUri)) {\n              return;\n            }\n\n            const query = new URLSearchParams({ path: node.relativePath });\n            const response = await fetch(\n              `${serverUrl}/api/projects/${registeredProject.id}/file?${query}`,\n            );\n\n            if (!response.ok || cancelled) {\n              return;\n            }\n\n            const file = await response.json() as ProjectFileResponse;\n            const model = editorApi.editor.createModel(\n              file.content,\n              getEditorLanguage(node.name),\n              modelUri,\n            );\n            createdModels.push(model);\n          }));\n\n          if (cancelled) {\n            return;\n          }\n        }\n      } catch {\n        // Background diagnostics must not block normal file navigation.\n      }\n    }\n\n    void indexProject();\n\n    return () => {\n      cancelled = true;\n      markerSubscription.dispose();\n      createdModels.forEach((model) => model.dispose());\n    };\n  }, [activeProject, monaco, tree]);\n\n  const openFile = useCallback(async (node: ProjectTreeNode) => {\n    if (!activeProject || node.isDirectory) {\n      return;\n    }\n\n    setActivePath(node.relativePath);\n\n    if (tabs.some((tab) => tab.relativePath === node.relativePath)) {\n      return;\n    }\n\n    setTabs((current) => [\n      ...current,\n      {\n        relativePath: node.relativePath,\n        name: node.name,\n        content: \"\",\n        savedContent: \"\",\n        loading: true,\n        error: null,\n      },\n    ]);\n\n    try {\n      const registeredProject = await registerProject(activeProject.path);\n      const query = new URLSearchParams({ path: node.relativePath });\n      const response = await fetch(\n        `${serverUrl}/api/projects/${registeredProject.id}/file?${query}`,\n      );\n\n      if (!response.ok) {\n        throw new Error(`Unable to open file (HTTP ${response.status})`);\n      }\n\n      const file = await response.json() as ProjectFileResponse;\n\n      setTabs((current) => current.map((tab) =>\n        tab.relativePath === node.relativePath\n          ? {\n              ...tab,\n              content: file.content,\n              savedContent: file.content,\n              loading: false,\n            }\n          : tab,\n      ));\n    } catch (openError) {\n      setTabs((current) => current.map((tab) =>\n        tab.relativePath === node.relativePath\n          ? {\n              ...tab,\n              loading: false,\n              error: openError instanceof Error\n                ? openError.message\n                : \"Unable to open file\",\n            }\n          : tab,\n      ));\n    }\n  }, [activeProject, tabs]);\n\n  const saveFile = useCallback(async (tab: EditorTab) => {\n    if (!activeProject || tab.loading || tab.error) {\n      return;\n    }\n\n    setSavingPath(tab.relativePath);\n\n    try {\n      const registeredProject = await registerProject(activeProject.path);\n      const response = await fetch(\n        `${serverUrl}/api/projects/${registeredProject.id}/file`,\n        {\n          method: \"PUT\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({\n            relativePath: tab.relativePath,\n            content: tab.content,\n          }),\n        },\n      );\n\n      if (!response.ok) {\n        throw new Error(`Unable to save file (HTTP ${response.status})`);\n      }\n\n      setTabs((current) => current.map((item) =>\n        item.relativePath === tab.relativePath\n          ? { ...item, savedContent: tab.content, error: null }\n          : item,\n      ));\n    } catch (saveError) {\n      setTabs((current) => current.map((item) =>\n        item.relativePath === tab.relativePath\n          ? {\n              ...item,\n              error: saveError instanceof Error\n                ? saveError.message\n                : \"Unable to save file\",\n            }\n          : item,\n      ));\n    } finally {\n      setSavingPath(null);\n    }\n  }, [activeProject]);\n\n  const activeTab = tabs.find(\n    (tab) => tab.relativePath === activePath,\n  ) ?? null;\n\n  useEffect(() => {\n    function handleSaveShortcut(event: KeyboardEvent) {\n      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === \"s\") {\n        event.preventDefault();\n\n        if (activeTab) {\n          void saveFile(activeTab);\n        }\n      }\n    }\n\n    window.addEventListener(\"keydown\", handleSaveShortcut);\n    return () => window.removeEventListener(\"keydown\", handleSaveShortcut);\n  }, [activeTab, saveFile]);\n\n  function updateFile(relativePath: string, content: string) {\n    setTabs((current) => current.map((tab) =>\n      tab.relativePath === relativePath\n        ? { ...tab, content, error: null }\n        : tab,\n    ));\n  }\n\n  function updateFileErrors(relativePath: string, errorCount: number) {\n    setFileErrors((current) => {\n      if (current[relativePath] === errorCount) {\n        return current;\n      }\n\n      if (errorCount === 0) {\n        const next = { ...current };\n        delete next[relativePath];\n        return next;\n      }\n\n      return { ...current, [relativePath]: errorCount };\n    });\n  }\n\n  function toggleFolder(relativePath: string) {\n    setExpandedFolders((current) => {\n      const next = new Set(current);\n\n      if (next.has(relativePath)) {\n        next.delete(relativePath);\n      } else {\n        next.add(relativePath);\n      }\n\n      return next;\n    });\n  }\n\n  function closeTab(relativePath: string) {\n    const tab = tabs.find((item) => item.relativePath === relativePath);\n\n    if (\n      tab\n      && tab.content !== tab.savedContent\n      && !window.confirm(`Discard unsaved changes to ${tab.name}?`)\n    ) {\n      return;\n    }\n\n    const tabIndex = tabs.findIndex(\n      (item) => item.relativePath === relativePath,\n    );\n    const remainingTabs = tabs.filter(\n      (item) => item.relativePath !== relativePath,\n    );\n\n    setTabs(remainingTabs);\n\n    if (activePath === relativePath) {\n      setActivePath(\n        remainingTabs[Math.max(0, tabIndex - 1)]?.relativePath ?? null,\n      );\n    }\n  }\n\r\n  if (!activeProject) {\r\n    return (\r\n      <div className=\"dcode-workspace-view\">\r\n        No project selected.\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\n    <section className=\"dcode-project-workspace\">\n      <header className=\"dcode-commandbar\">\n        <div className=\"dcode-commandbar__project\">\n          <IconButton\n            label=\"Back to projects\"\n            icon={<ArrowLeft size={17} />}\n            variant=\"ghost\"\n            onClick={() => setActiveWorkspace(\"projects\")}\n          />\n          <DCodeLogo className=\"dcode-commandbar__brand\" size={30} title=\"DCode\" />\n          <div className=\"dcode-commandbar__identity\">\n            <strong>{activeProject.name}</strong>\n            <span title={activeProject.path}>{activeProject.path}</span>\n          </div>\n        </div>\n\n        <div className=\"dcode-commandbar__menus\" aria-label=\"Project menus\">\n          {[\n            \"File\",\n            \"Edit\",\n            \"View\",\n            \"Run\",\n            \"Agent\",\n          ].map((menu) => (\n            <Button key={menu} size=\"sm\" variant=\"ghost\">\n              {menu}\n            </Button>\n          ))}\n        </div>\n\n        <div className=\"dcode-commandbar__tools\">\n          <Button\n            size=\"sm\"\n            variant=\"ghost\"\n            icon={<Save size={14} />}\n            loading={savingPath === activeTab?.relativePath}\n            disabled={\n              !activeTab\n              || activeTab.loading\n              || activeTab.content === activeTab.savedContent\n            }\n            onClick={() => activeTab && void saveFile(activeTab)}\n          >\n            Save\n          </Button>\n          <Button\n            size=\"sm\"\n            variant={explorerOpen ? \"secondary\" : \"ghost\"}\n            icon={<PanelLeft size={14} />}\n            aria-pressed={explorerOpen}\n            onClick={() => setExplorerOpen((current) => !current)}\n          >\n            Explorer\n          </Button>\n          <Button\n            size=\"sm\"\n            variant={chatOpen ? \"secondary\" : \"ghost\"}\n            icon={<MessageSquare size={14} />}\n            aria-pressed={chatOpen}\n            onClick={() => setChatOpen((current) => !current)}\n          >\n            Chat\n          </Button>\n          <Button\n            size=\"sm\"\n            variant={terminalOpen ? \"secondary\" : \"ghost\"}\n            icon={<TerminalSquare size={14} />}\n            aria-pressed={terminalOpen}\n            onClick={() => setTerminalOpen((current) => !current)}\n          >\n            Terminal\n          </Button>\n          <IconButton\n            label=\"Run project\"\n            icon={<Play size={16} />}\n            variant=\"ghost\"\n            disabled\n          />\n          <IconButton\n            label=\"More project actions\"\n            icon={<MoreHorizontal size={18} />}\n            variant=\"ghost\"\n          />\n        </div>\n      </header>\n\n      <div className={`dcode-project-workspace__body ${\n        !explorerOpen ? \"is-explorer-closed\" : \"\"\n      } ${chatOpen ? \"is-chat-open\" : \"\"}`}>\n        {explorerOpen && <aside className=\"dcode-explorer\">\n          <div className=\"dcode-explorer__header\">\n            <span>Explorer</span>\n            <span className=\"dcode-explorer__count\">\n              {tree.length}\n            </span>\n          </div>\n\n          <div className=\"dcode-explorer__project\">\n            <ChevronDown size={14} />\n            <FolderGit2 size={15} />\n            <strong>{activeProject.name}</strong>\n          </div>\n\n          <div className=\"dcode-explorer__tree\">\n            {loading && (\n              <p className=\"dcode-explorer__status\">\n                Loading files...\n              </p>\n            )}\n\n            {error && (\n              <p className=\"dcode-project-error\">\n                {error}\n              </p>\n            )}\n\n            {!loading && tree.map((node) => (\n              <TreeNode\n                key={node.relativePath}\n                node={node}\n                activePath={activePath}\n                expandedFolders={expandedFolders}\n                fileErrors={fileErrors}\n                onOpenFile={openFile}\n                onToggleFolder={toggleFolder}\n              />\n            ))}\n          </div>\n        </aside>}\n\n        <main className=\"dcode-editor-workspace\">\n          {tabs.length > 0 && (\n            <div className=\"dcode-editor-tabs\" role=\"tablist\">\n              {tabs.map((tab) => {\n                const isActive = tab.relativePath === activePath;\n                const isDirty = tab.content !== tab.savedContent;\n\n                return (\n                  <div\n                    className={`dcode-editor-tab ${isActive ? \"is-active\" : \"\"}`}\n                    key={tab.relativePath}\n                  >\n                    <button\n                      type=\"button\"\n                      className=\"dcode-editor-tab__select\"\n                      role=\"tab\"\n                      aria-selected={isActive}\n                      title={tab.relativePath}\n                      onClick={() => setActivePath(tab.relativePath)}\n                    >\n                      <FileTypeIcon name={tab.name} />\n                      <span>{tab.name}</span>\n                      {isDirty && <span className=\"dcode-editor-tab__dirty\" />}\n                    </button>\n                    <button\n                      type=\"button\"\n                      className=\"dcode-editor-tab__close\"\n                      aria-label={`Close ${tab.name}`}\n                      onClick={() => closeTab(tab.relativePath)}\n                    >\n                      <X size={13} />\n                    </button>\n                  </div>\n                );\n              })}\n            </div>\n          )}\n\n          {activeTab ? (\n            <div className=\"dcode-editor-pane\">\n              <div className=\"dcode-editor-toolbar\">\n                <span title={activeTab.relativePath}>\n                  {activeTab.relativePath}\n                </span>\n                <Button\n                  size=\"sm\"\n                  variant=\"ghost\"\n                  icon={<Save size={14} />}\n                  loading={savingPath === activeTab.relativePath}\n                  disabled={\n                    activeTab.loading\n                    || activeTab.content === activeTab.savedContent\n                  }\n                  onClick={() => void saveFile(activeTab)}\n                >\n                  Save\n                </Button>\n              </div>\n\n              {activeTab.error && (\n                <div className=\"dcode-editor-error\">{activeTab.error}</div>\n              )}\n\n              <div className=\"dcode-monaco-container\">\n                {activeTab.loading ? (\n                  <div className=\"dcode-editor-loading\">Opening file...</div>\n                ) : (\n                  <Editor\n                    path={getMonacoModelPath(activeTab.relativePath)}\n                    language={getEditorLanguage(activeTab.name)}\n                    value={activeTab.content}\n                    theme=\"vs-dark\"\n                    beforeMount={configureMonaco}\n                    onValidate={(markers: Parameters<OnValidate>[0]) => updateFileErrors(\n                      activeTab.relativePath,\n                      markers.filter((marker) => marker.severity === 8).length,\n                    )}\n                    onChange={(value: string | undefined) => updateFile(\n                      activeTab.relativePath,\n                      value ?? \"\",\n                    )}\n                    options={{\n                      automaticLayout: true,\n                      fontSize: 13,\n                      minimap: { enabled: true },\n                      padding: { top: 12 },\n                      scrollBeyondLastLine: false,\n                      smoothScrolling: true,\n                    }}\n                  />\n                )}\n              </div>\n            </div>\n          ) : (\n            <div className=\"dcode-editor-canvas\">\n              <div className=\"dcode-editor-canvas__empty\">\n                <span className=\"dcode-editor-canvas__icon\">\n                  <Code2 size={26} />\n                </span>\n                <h2>{activeProject.name}</h2>\n                <p>Select a file from Explorer to start editing.</p>\n                <span className=\"dcode-editor-canvas__hint\">\n                  Your files stay local\n                </span>\n              </div>\n            </div>\n          )}\n        </main>\n\n        {chatOpen && (\n          <aside className=\"dcode-project-panel dcode-project-panel--chat\">\n            <div className=\"dcode-project-panel__header\">\n              <strong>Agent chat</strong>\n              <IconButton\n                label=\"Close agent chat\"\n                icon={<X size={14} />}\n                variant=\"ghost\"\n                onClick={() => setChatOpen(false)}\n              />\n            </div>\n            <div className=\"dcode-project-panel__empty\">\n              <MessageSquare size={22} />\n              <span>Agent chat will live here.</span>\n            </div>\n          </aside>\n        )}\n      </div>\n\n      {terminalOpen && (\n        <section className=\"dcode-terminal-panel\">\n          <div className=\"dcode-project-panel__header\">\n            <strong>Terminal</strong>\n            <span>Local shell integration is coming next.</span>\n            <IconButton\n              label=\"Close terminal\"\n              icon={<X size={14} />}\n              variant=\"ghost\"\n              onClick={() => setTerminalOpen(false)}\n            />\n          </div>\n          <div className=\"dcode-terminal-panel__body\">\n            <span aria-hidden>&gt;</span>\n            <span>Terminal ready</span>\n          </div>\n        </section>\n      )}\n    </section>\n  );\n}\n\r\nfunction TreeNode({\n  node,\n  activePath,\n  expandedFolders,\n  fileErrors,\n  onOpenFile,\n  onToggleFolder,\n}: {\n  node: ProjectTreeNode;\n  activePath: string | null;\n  expandedFolders: Set<string>;\n  fileErrors: Record<string, number>;\n  onOpenFile: (node: ProjectTreeNode) => void;\n  onToggleFolder: (relativePath: string) => void;\n}) {\n  const expanded = expandedFolders.has(node.relativePath);\n  const errorCount = node.isDirectory\n    ? getTreeErrorCount(node, fileErrors)\n    : fileErrors[node.relativePath] ?? 0;\n\n  const rowStyle = {\n    paddingLeft: \"8px\",\n  };\n\n  if (!node.isDirectory) {\n    return (\n      <button\n        type=\"button\"\n        className={`dcode-tree-item dcode-tree-item--file ${\n          activePath === node.relativePath ? \"is-active\" : \"\"\n        }`}\n        style={rowStyle}\n        title={node.relativePath}\n        onClick={() => onOpenFile(node)}\n      >\n        <span className=\"dcode-tree-item__chevron\" />\n        <FileTypeIcon name={node.name} />\n        <span className=\"dcode-tree-item__label\">\n          {node.name}\n        </span>\n        {errorCount > 0 && (\n          <span\n            className=\"dcode-tree-item__errors\"\n            title={`${errorCount} error${errorCount === 1 ? \"\" : \"s\"}`}\n          >\n            <TriangleAlert size={12} />\n            {errorCount}\n          </span>\n        )}\n      </button>\n    );\n  }\n\n  return (\n    <div className=\"dcode-tree-node\">\n      <button\n        type=\"button\"\n        className={`dcode-tree-item dcode-tree-item--folder ${\n          expanded ? \"is-expanded\" : \"\"\n        }`}\n        style={rowStyle}\n        title={node.relativePath}\n        aria-expanded={expanded}\n        onClick={() => onToggleFolder(node.relativePath)}\n      >\n        <span className=\"dcode-tree-item__chevron\">\n          {expanded ? (\n            <ChevronDown size={14} />\n          ) : (\n            <ChevronRight size={14} />\n          )}\n        </span>\n\n        {expanded ? (\n          <FolderOpen className=\"dcode-tree-icon--folder\" size={15} />\n        ) : (\n          <Folder className=\"dcode-tree-icon--folder\" size={15} />\n        )}\n        <span className=\"dcode-tree-item__label\">\n          {node.name}\n        </span>\n        {errorCount > 0 && (\n          <span\n            className=\"dcode-tree-item__errors\"\n            title={`${errorCount} error${errorCount === 1 ? \"\" : \"s\"}`}\n          >\n            {errorCount}\n          </span>\n        )}\n      </button>\n\n      {expanded && node.children && (\n        <div\n          className=\"dcode-tree-children\"\n        >\n          {node.children.map((child) => (\n            <TreeNode\n              key={child.relativePath}\n              node={child}\n              activePath={activePath}\n              expandedFolders={expandedFolders}\n              fileErrors={fileErrors}\n              onOpenFile={onOpenFile}\n              onToggleFolder={onToggleFolder}\n            />\n          ))}\n        </div>\n      )}\n    </div>\n  );\n}\n\nfunction getTreeErrorCount(\n  node: ProjectTreeNode,\n  fileErrors: Record<string, number>,\n): number {\n  if (!node.isDirectory) {\n    return fileErrors[node.relativePath] ?? 0;\n  }\n\n  return node.children?.reduce(\n    (total, child) => total + getTreeErrorCount(child, fileErrors),\n    0,\n  ) ?? 0;\n}\n\nfunction collectDiagnosticFiles(\n  nodes: ProjectTreeNode[],\n): ProjectTreeNode[] {\n  return nodes.flatMap((node) => {\n    if (node.isDirectory) {\n      return collectDiagnosticFiles(node.children ?? []);\n    }\n\n    const extension = node.name.split(\".\").pop()?.toLowerCase();\n    return diagnosticExtensions.has(extension ?? \"\") ? [node] : [];\n  });\n}\n\nfunction getMonacoModelPath(relativePath: string): string {\n  return `file:///dcode/${relativePath.replaceAll(\"\\\\\", \"/\")}`;\n}\n\nfunction getFileName(relativePath: string): string {\n  return relativePath.split(/[\\\\/]/).pop() ?? relativePath;\n}\n\nfunction FileTypeIcon({ name }: { name: string }) {\n  const extension = name.split(\".\").pop()?.toLowerCase();\n\n  if (name.startsWith(\".\") || extension === \"config\") {\n    return <Settings className=\"dcode-tree-icon--muted\" size={15} />;\n  }\n\n  if (extension === \"json\") {\n    return <FileJson className=\"dcode-tree-icon--warning\" size={15} />;\n  }\n\n  if ([\"ts\", \"tsx\", \"js\", \"jsx\"].includes(extension ?? \"\")) {\n    return <FileCode2 className=\"dcode-tree-icon--info\" size={15} />;\n  }\n\n  if ([\"css\", \"scss\", \"html\"].includes(extension ?? \"\")) {\n    return <Braces className=\"dcode-tree-icon--primary\" size={15} />;\n  }\n\n  if ([\"md\", \"txt\"].includes(extension ?? \"\")) {\n    return <FileText className=\"dcode-tree-icon--muted\" size={15} />;\n  }\n\n  if ([\"sql\", \"db\", \"sqlite\"].includes(extension ?? \"\")) {\n    return <Database className=\"dcode-tree-icon--success\" size={15} />;\n  }\n\n  if ([\"cs\", \"csproj\", \"sln\"].includes(extension ?? \"\")) {\n    return <Code2 className=\"dcode-tree-icon--primary\" size={15} />;\n  }\n\n  return <File className=\"dcode-tree-icon--muted\" size={15} />;\n}\n\nfunction getEditorLanguage(name: string): string {\n  const extension = name.split(\".\").pop()?.toLowerCase();\n  const languages: Record<string, string> = {\n    cs: \"csharp\",\n    csproj: \"xml\",\n    css: \"css\",\n    html: \"html\",\n    js: \"javascript\",\n    json: \"json\",\n    jsx: \"javascript\",\n    md: \"markdown\",\n    scss: \"scss\",\n    sql: \"sql\",\n    ts: \"typescript\",\n    tsx: \"typescript\",\n    xml: \"xml\",\n    yaml: \"yaml\",\n    yml: \"yaml\",\n  };\n\n  return languages[extension ?? \"\"] ?? \"plaintext\";\n}\n"}