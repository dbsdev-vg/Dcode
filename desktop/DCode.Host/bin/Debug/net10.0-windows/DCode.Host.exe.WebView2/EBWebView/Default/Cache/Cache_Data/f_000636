{"relativePath":"src\\components\\player\\PlayerBar.tsx","content":"\"use client\";\r\n\r\nimport {\r\n  Pause,\r\n  Play,\r\n  Shuffle,\r\n  Repeat,\r\n  Repeat1,\r\n  ListMusic,\r\n  Volume2,\r\n  VolumeX,\r\n} from \"lucide-react\";\r\n\r\nimport { usePlayerStore } from \"@/modules/player/player.store\";\r\nimport { useExpandedPlayerStore } from \"@/modules/player/expanded-player.store\";\r\nimport ProgressBar from \"./ProgressBar\";\r\nimport { formatTime } from \"@/lib/formatTime\";\r\nimport { audioEngine } from \"@/modules/player/player.engine\";\r\nimport { useQueueModalStore } from \"@/modules/player/queue-modal.store\";\r\nimport { useState, useEffect, useRef, useMemo } from \"react\";\r\nimport { Track } from \"@/types/track\";\r\n\r\nexport default function PlayerBar() {\r\n  const {\r\n    currentTrack,\r\n    isPlaying,\r\n    currentTime,\r\n    duration,\r\n    isShuffled,\r\n    repeatMode,\r\n    toggleRepeat,\r\n    nextTrack,\r\n    previousTrack,\r\n    togglePlayback,\r\n    toggleShuffle,\r\n    getActiveQueue,\r\n    currentIndex,\r\n  } = usePlayerStore();\r\n\r\n  const openExpanded = useExpandedPlayerStore((state) => state.open);\r\n  const openQueue = useQueueModalStore((state) => state.open);\r\n  const [volume, setVolume] = useState(0.5);\r\n  const [isMuted, setIsMuted] = useState(false);\r\n  const volumeRef = useRef<HTMLDivElement>(null);\r\n  const latestVolume = useRef(volume);\r\n  const [titleOverflows, setTitleOverflows] = useState(false);\r\n  const [artistOverflows, setArtistOverflows] = useState(false);\r\n  const titleContainerRef = useRef<HTMLDivElement>(null);\r\n  const titleTextRef = useRef<HTMLDivElement>(null);\r\n  const artistContainerRef = useRef<HTMLDivElement>(null);\r\n  const artistTextRef = useRef<HTMLDivElement>(null);\r\n\r\n  // Swipe state\r\n  const [dragOffset, setDragOffset] = useState(0);\r\n  const [isDragging, setIsDragging] = useState(false);\r\n  const swipeStartX = useRef<number | null>(null);\r\n  const dragContentRef = useRef<HTMLDivElement>(null);\r\n  const swipeThreshold = 70;\r\n\r\n  // Get active queue (respects shuffle) and previous/next tracks\r\n  const activeQueue = useMemo(\r\n    () => getActiveQueue(),\r\n    [getActiveQueue, isShuffled, currentTrack],\r\n  );\r\n  const prevTrack: Track | null =\r\n    activeQueue && currentIndex > 0 ? activeQueue[currentIndex - 1] : null;\r\n  const nextTrackObj: Track | null =\r\n    activeQueue && currentIndex < activeQueue.length - 1\r\n      ? activeQueue[currentIndex + 1]\r\n      : null;\r\n\r\n  // Direction and incoming track for preview\r\n  const swipeDirection =\r\n    dragOffset > 0 ? \"right\" : dragOffset < 0 ? \"left\" : null;\r\n  const incomingTrack =\r\n    swipeDirection === \"right\"\r\n      ? prevTrack\r\n      : swipeDirection === \"left\"\r\n        ? nextTrackObj\r\n        : null;\r\n\r\n  // Inject marquee styles\r\n  useEffect(() => {\r\n    if (!document.getElementById(\"marquee-styles\")) {\r\n      const style = document.createElement(\"style\");\r\n      style.id = \"marquee-styles\";\r\n      style.textContent = `\r\n        @keyframes marquee {\r\n          0% { transform: translateX(0%); }\r\n          100% { transform: translateX(-50%); }\r\n        }\r\n        .marquee-container {\r\n          overflow-x: hidden;\r\n          white-space: nowrap;\r\n          width: 100%;\r\n        }\r\n        .marquee-content {\r\n          display: inline-block;\r\n          animation: marquee linear infinite;\r\n          padding-right: 2rem;\r\n        }\r\n      `;\r\n      document.head.appendChild(style);\r\n    }\r\n\r\n    console.log(\"PlayerBar mounted\");\r\n    return () => console.log(\"PlayerBar unmounted\");\r\n  }, []);\r\n\r\n  // Volume wheel\r\n  useEffect(() => {\r\n    latestVolume.current = volume;\r\n  }, [volume]);\r\n\r\n  useEffect(() => {\r\n    const el = volumeRef.current;\r\n    if (!el) return;\r\n    const handleWheel = (e: WheelEvent) => {\r\n      e.preventDefault();\r\n      e.stopPropagation();\r\n      const delta = e.deltaY > 0 ? -0.05 : 0.05;\r\n      let newVolume = latestVolume.current + delta;\r\n      newVolume = Math.min(1, Math.max(0, newVolume));\r\n      setVolume(newVolume);\r\n      audioEngine.setVolume?.(newVolume);\r\n      setIsMuted(newVolume === 0);\r\n    };\r\n    el.addEventListener(\"wheel\", handleWheel, { passive: false });\r\n    return () => el.removeEventListener(\"wheel\", handleWheel);\r\n  }, []);\r\n\r\n  // Overflow detection for marquee\r\n  useEffect(() => {\r\n    const checkOverflow = () => {\r\n      if (titleContainerRef.current && titleTextRef.current) {\r\n        const containerWidth = titleContainerRef.current.clientWidth;\r\n        const textWidth = titleTextRef.current.scrollWidth;\r\n        setTitleOverflows(textWidth > containerWidth);\r\n      }\r\n      if (artistContainerRef.current && artistTextRef.current) {\r\n        const containerWidth = artistContainerRef.current.clientWidth;\r\n        const textWidth = artistTextRef.current.scrollWidth;\r\n        setArtistOverflows(textWidth > containerWidth);\r\n      }\r\n    };\r\n    checkOverflow();\r\n    window.addEventListener(\"resize\", checkOverflow);\r\n    return () => window.removeEventListener(\"resize\", checkOverflow);\r\n  }, [currentTrack]);\r\n\r\n  // Swipe handlers with preview\r\n  const handleDragStart = (e: React.TouchEvent | React.MouseEvent) => {\r\n    const clientX = \"touches\" in e ? e.touches[0].clientX : e.clientX;\r\n    swipeStartX.current = clientX;\r\n    setIsDragging(true);\r\n    setDragOffset(0);\r\n  };\r\n\r\n  const handleDragMove = (e: React.TouchEvent | React.MouseEvent) => {\r\n    if (!isDragging || swipeStartX.current === null) return;\r\n    const currentX = \"touches\" in e ? e.touches[0].clientX : e.clientX;\r\n    let delta = currentX - swipeStartX.current;\r\n    // Clamp to a reasonable range (optional)\r\n    setDragOffset(delta);\r\n  };\r\n\r\n  const handleDragEnd = () => {\r\n    if (!isDragging) return;\r\n    setIsDragging(false);\r\n    const absOffset = Math.abs(dragOffset);\r\n    if (absOffset > swipeThreshold && incomingTrack) {\r\n      // Animate the current track fully off screen\r\n      const finalOffset =\r\n        dragOffset > 0 ? window.innerWidth : -window.innerWidth;\r\n      setDragOffset(finalOffset);\r\n      setTimeout(() => {\r\n        // Perform actual track change using store actions\r\n        if (dragOffset > 0) previousTrack();\r\n        else nextTrack();\r\n        // Reset offset after track changes\r\n        setDragOffset(0);\r\n      }, 200);\r\n    } else {\r\n      // Spring back to zero\r\n      setDragOffset(0);\r\n    }\r\n    swipeStartX.current = null;\r\n  };\r\n\r\n  const handleSeek = (time: number) => {\r\n    audioEngine.seek(time);\r\n    usePlayerStore.getState().setCurrentTime(time);\r\n  };\r\n\r\n  const handleVolumeChange = (e: React.ChangeEvent<HTMLInputElement>) => {\r\n    const vol = parseFloat(e.target.value);\r\n    setVolume(vol);\r\n    audioEngine.setVolume?.(vol);\r\n    setIsMuted(vol === 0);\r\n  };\r\n\r\n  const toggleMute = () => {\r\n    if (isMuted) {\r\n      audioEngine.setVolume?.(volume || 0.5);\r\n      setIsMuted(false);\r\n    } else {\r\n      audioEngine.setVolume?.(0);\r\n      setIsMuted(true);\r\n    }\r\n  };\r\n\r\n  if (!currentTrack) {\r\n    return (\r\n      <div className=\"fixed bottom-16 left-0 right-0 bg-zinc-950/95 backdrop-blur-md border-t border-zinc-800 z-40 shadow-lg md:bottom-0 px-4 py-3\">\r\n        <p className=\"text-sm text-zinc-400 text-center\">No track playing</p>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div\r\n      className=\"fixed bottom-16 left-0 right-0 bg-zinc-950/95 backdrop-blur-md border-t border-zinc-800 z-40 shadow-lg md:bottom-0 select-none overflow-hidden\"\r\n      onTouchStart={handleDragStart}\r\n      onTouchMove={handleDragMove}\r\n      onTouchEnd={handleDragEnd}\r\n      onMouseDown={handleDragStart}\r\n      onMouseMove={handleDragMove}\r\n      onMouseUp={handleDragEnd}\r\n      onMouseLeave={handleDragEnd}\r\n    >\r\n      {/* Progress bar */}\r\n      <div className=\"relative\">\r\n        <div className=\"absolute top-0 left-0 right-0 h-1 bg-zinc-800\">\r\n          <ProgressBar\r\n            current={currentTime}\r\n            duration={duration}\r\n            onSeek={handleSeek}\r\n            className=\"h-full\"\r\n          />\r\n        </div>\r\n      </div>\r\n\r\n      {/* Swipe container - holds both current and preview tracks */}\r\n      <div className=\"relative px-4 pt-3 pb-2\">\r\n        {/* Incoming track preview (absolute, slides from side) */}\r\n        {incomingTrack && (\r\n          <div\r\n            className=\"absolute top-3 left-4 right-4 transition-transform duration-75 ease-linear pointer-events-none\"\r\n            style={{\r\n              transform:\r\n                swipeDirection === \"right\"\r\n                  ? `translateX(calc(-100% + ${Math.max(0, dragOffset)}px))`\r\n                  : swipeDirection === \"left\"\r\n                    ? `translateX(calc(100% - ${Math.abs(dragOffset)}px))`\r\n                    : \"translateX(100%)\",\r\n              opacity: Math.min(1, Math.abs(dragOffset) / swipeThreshold),\r\n            }}\r\n          >\r\n            <div className=\"flex items-center gap-3 min-w-0\">\r\n              <div className=\"w-10 h-10 rounded-md overflow-hidden bg-zinc-800 shadow-md flex-shrink-0\">\r\n                {incomingTrack.cover ? (\r\n                  <img\r\n                    src={incomingTrack.cover}\r\n                    alt={incomingTrack.title}\r\n                    className=\"w-full h-full object-cover\"\r\n                  />\r\n                ) : (\r\n                  <div className=\"w-full h-full flex items-center justify-center bg-gradient-to-br from-zinc-800 to-zinc-900\">\r\n                    <span className=\"text-xs text-zinc-500\">\uD83C\uDFB5</span>\r\n                  </div>\r\n                )}\r\n              </div>\r\n              <div className=\"min-w-0 flex-1\">\r\n                <p className=\"text-sm font-medium truncate\">\r\n                  {incomingTrack.title}\r\n                </p>\r\n                <p className=\"text-xs text-zinc-500 truncate\">\r\n                  {incomingTrack.artist}\r\n                </p>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        )}\r\n\r\n        {/* Current track content - slides with drag */}\r\n        <div\r\n          ref={dragContentRef}\r\n          className=\"transition-transform duration-75 ease-linear\"\r\n          style={{\r\n            transform: `translateX(${dragOffset}px)`,\r\n            transition: isDragging\r\n              ? \"none\"\r\n              : \"transform 0.2s cubic-bezier(0.2, 0.9, 0.4, 1.1)\",\r\n          }}\r\n        >\r\n          <div className=\"flex items-center justify-between gap-3\">\r\n            {/* LEFT: Cover + Track Info */}\r\n            <div className=\"flex items-center gap-3 min-w-0 flex-1\">\r\n              <div\r\n                className=\"w-10 h-10 rounded-md overflow-hidden bg-zinc-800 shadow-md cursor-pointer flex-shrink-0\"\r\n                onClick={openExpanded}\r\n              >\r\n                {currentTrack.cover ? (\r\n                  <img\r\n                    src={currentTrack.cover}\r\n                    alt={currentTrack.title}\r\n                    className=\"w-full h-full object-cover\"\r\n                  />\r\n                ) : (\r\n                  <div className=\"w-full h-full flex items-center justify-center bg-gradient-to-br from-zinc-800 to-zinc-900\">\r\n                    <span className=\"text-xs text-zinc-500\">\uD83C\uDFB5</span>\r\n                  </div>\r\n                )}\r\n              </div>\r\n\r\n              <div className=\"min-w-0 flex-1\">\r\n                <div\r\n                  onClick={openExpanded}\r\n                  className=\"cursor-pointer hover:underline decoration-zinc-500 underline-offset-2\"\r\n                >\r\n                  <div\r\n                    ref={titleContainerRef}\r\n                    className=\"marquee-container\"\r\n                    style={{ width: \"100%\" }}\r\n                  >\r\n                    <div\r\n                      ref={titleTextRef}\r\n                      className={`text-sm font-medium ${\r\n                        titleOverflows ? \"marquee-content\" : \"truncate\"\r\n                      }`}\r\n                      style={{\r\n                        animationDuration: titleOverflows ? \"10s\" : \"none\",\r\n                      }}\r\n                    >\r\n                      {currentTrack.title}\r\n                      {titleOverflows && (\r\n                        <span className=\"ml-4\">{currentTrack.title}</span>\r\n                      )}\r\n                    </div>\r\n                  </div>\r\n                  <div\r\n                    ref={artistContainerRef}\r\n                    className=\"marquee-container mt-0.5\"\r\n                    style={{ width: \"100%\" }}\r\n                  >\r\n                    <div\r\n                      ref={artistTextRef}\r\n                      className={`text-xs text-zinc-500 ${\r\n                        artistOverflows ? \"marquee-content\" : \"truncate\"\r\n                      }`}\r\n                      style={{\r\n                        animationDuration: artistOverflows ? \"12s\" : \"none\",\r\n                      }}\r\n                    >\r\n                      {currentTrack.artist}\r\n                      {artistOverflows && (\r\n                        <span className=\"ml-4\">{currentTrack.artist}</span>\r\n                      )}\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            {/* RIGHT: Controls (all matching style, shuffle/repeat on right side) */}\r\n            <div className=\"flex items-center gap-2 flex-shrink-0\">\r\n              <button\r\n                onClick={togglePlayback}\r\n                className=\"w-8 h-8 rounded-full bg-white text-black flex items-center justify-center shadow-md hover:scale-105 active:scale-95 transition\"\r\n                title={isPlaying ? \"Pause\" : \"Play\"}\r\n              >\r\n                {isPlaying ? (\r\n                  <Pause size={14} fill=\"currentColor\" />\r\n                ) : (\r\n                  <Play size={14} fill=\"currentColor\" className=\"ml-0.5\" />\r\n                )}\r\n              </button>\r\n\r\n              <button\r\n                onClick={openQueue}\r\n                className=\"p-1 rounded-md text-zinc-400 hover:text-white transition active:scale-90\"\r\n                title=\"Queue\"\r\n              >\r\n                <ListMusic size={16} />\r\n              </button>\r\n\r\n              <button\r\n                onClick={toggleShuffle}\r\n                className={`p-1 rounded-md transition active:scale-90 ${\r\n                  isShuffled\r\n                    ? \"text-[#E52C2C]\"\r\n                    : \"text-zinc-400 hover:text-white\"\r\n                }`}\r\n                title=\"Shuffle\"\r\n              >\r\n                <Shuffle size={16} />\r\n              </button>\r\n              <button\r\n                onClick={toggleRepeat}\r\n                className={`p-1 rounded-md transition active:scale-90 ${\r\n                  repeatMode !== \"off\"\r\n                    ? \"text-[#E52C2C]\"\r\n                    : \"text-zinc-400 hover:text-white\"\r\n                }`}\r\n                title={repeatMode === \"one\" ? \"Repeat one\" : \"Repeat all\"}\r\n              >\r\n                {repeatMode === \"one\" ? (\r\n                  <Repeat1 size={16} />\r\n                ) : (\r\n                  <Repeat size={16} />\r\n                )}\r\n              </button>\r\n\r\n              <div className=\"w-px h-5 bg-zinc-800 mx-1\" />\r\n\r\n              <div\r\n                ref={volumeRef}\r\n                className=\"hidden sm:flex items-center gap-1\"\r\n                title=\"Scroll to adjust volume\"\r\n              >\r\n                <button\r\n                  onClick={toggleMute}\r\n                  className=\"p-1 rounded-md text-zinc-400 hover:text-white active:scale-90\"\r\n                >\r\n                  {isMuted || volume === 0 ? (\r\n                    <VolumeX size={16} />\r\n                  ) : (\r\n                    <Volume2 size={16} />\r\n                  )}\r\n                </button>\r\n                <input\r\n                  type=\"range\"\r\n                  min=\"0\"\r\n                  max=\"1\"\r\n                  step=\"0.01\"\r\n                  value={isMuted ? 0 : volume}\r\n                  onChange={handleVolumeChange}\r\n                  className=\"w-16 h-1 bg-zinc-700 rounded-lg appearance-none cursor-pointer accent-white\"\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          {/* Timestamps */}\r\n          <div className=\"flex justify-between text-[10px] text-zinc-600 tabular-nums font-mono mt-1 px-1\">\r\n            <span>{formatTime(currentTime)}</span>\r\n            <span>{formatTime(duration)}</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n"}