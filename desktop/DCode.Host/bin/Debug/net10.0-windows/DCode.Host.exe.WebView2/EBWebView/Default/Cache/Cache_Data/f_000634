{"relativePath":"src\\app\\playlists\\page.tsx","content":"//app/playlists/page.tsx\r\n\r\n\"use client\";\r\n\r\nimport { useState, useMemo } from \"react\";\r\nimport {\r\n  Music2,\r\n  Plus,\r\n  Trash2,\r\n  MoreVertical,\r\n  Search,\r\n  Pencil,\r\n  X,\r\n  ImageIcon,\r\n  LayoutGrid,\r\n  List,\r\n} from \"lucide-react\";\r\nimport { db, Playlist } from \"@/modules/db/db\";\r\nimport { useLiveQuery } from \"dexie-react-hooks\";\r\nimport Link from \"next/link\";\r\nimport { useLibraryStore } from \"@/modules/library/library.store\";\r\n\r\ntype SortField = \"name\" | \"count\" | \"updated\";\r\ntype SortOrder = \"asc\" | \"desc\";\r\ntype ViewMode = \"grid\" | \"list\";\r\n\r\nexport default function PlaylistsPage() {\r\n  const playlists = useLiveQuery(() => db.playlists.toArray(), []);\r\n  const tracks = useLibraryStore((state) => state.tracks);\r\n\r\n  // UI state\r\n  const [search, setSearch] = useState(\"\");\r\n  const [sortField, setSortField] = useState<SortField>(\"updated\");\r\n  const [sortOrder, setSortOrder] = useState<SortOrder>(\"desc\");\r\n  const [viewMode, setViewMode] = useState<ViewMode>(\"grid\");\r\n  const [isCreateModalOpen, setIsCreateModalOpen] = useState(false);\r\n  const [newName, setNewName] = useState(\"\");\r\n  const [newCover, setNewCover] = useState<string | undefined>(undefined);\r\n  const [newDescription, setNewDescription] = useState(\"\");\r\n  const [editingPlaylist, setEditingPlaylist] = useState<Playlist | null>(null);\r\n  const [deleteConfirmId, setDeleteConfirmId] = useState<string | null>(null);\r\n\r\n  // Compute song count and cover for each playlist\r\n  const enrichedPlaylists = useMemo(() => {\r\n    if (!playlists) return [];\r\n    return playlists.map((pl) => {\r\n      const playlistTracks = pl.trackIds\r\n        .map((id) => tracks.find((t) => t.id === id))\r\n        .filter(Boolean);\r\n      const cover = pl.cover || playlistTracks[0]?.cover;\r\n      return {\r\n        ...pl,\r\n        songCount: playlistTracks.length,\r\n        cover,\r\n      };\r\n    });\r\n  }, [playlists, tracks]);\r\n\r\n  // Filter and sort\r\n  const filteredPlaylists = useMemo(() => {\r\n    let result = [...enrichedPlaylists];\r\n    if (search.trim()) {\r\n      const q = search.toLowerCase();\r\n      result = result.filter((p) => p.name.toLowerCase().includes(q));\r\n    }\r\n    result.sort((a, b) => {\r\n      let aVal: string | number = \"\";\r\n      let bVal: string | number = \"\";\r\n      switch (sortField) {\r\n        case \"name\":\r\n          aVal = a.name.toLowerCase();\r\n          bVal = b.name.toLowerCase();\r\n          break;\r\n        case \"count\":\r\n          aVal = a.songCount;\r\n          bVal = b.songCount;\r\n          break;\r\n        case \"updated\":\r\n          aVal = a.updatedAt || a.createdAt;\r\n          bVal = b.updatedAt || b.createdAt;\r\n          break;\r\n      }\r\n      if (aVal < bVal) return sortOrder === \"asc\" ? -1 : 1;\r\n      if (aVal > bVal) return sortOrder === \"asc\" ? 1 : -1;\r\n      return 0;\r\n    });\r\n    return result;\r\n  }, [enrichedPlaylists, search, sortField, sortOrder]);\r\n\r\n  // Actions\r\n  async function createPlaylist() {\r\n    const trimmed = newName.trim();\r\n    if (!trimmed) return false;\r\n    const playlist: Playlist = {\r\n      id: crypto.randomUUID(),\r\n      name: trimmed,\r\n      trackIds: [],\r\n      createdAt: Date.now(),\r\n      updatedAt: Date.now(),\r\n      cover: newCover,\r\n      description: newDescription || undefined,\r\n    };\r\n    await db.playlists.add(playlist);\r\n    setNewName(\"\");\r\n    setNewCover(undefined);\r\n    setNewDescription(\"\");\r\n    setIsCreateModalOpen(false);\r\n    return true;\r\n  }\r\n\r\n  async function updatePlaylist(\r\n    playlist: Playlist,\r\n    updates: Partial<Playlist>,\r\n  ) {\r\n    await db.playlists.update(playlist.id, {\r\n      ...updates,\r\n      updatedAt: Date.now(),\r\n    });\r\n  }\r\n\r\n  async function deletePlaylist(id: string) {\r\n    await db.playlists.delete(id);\r\n    setDeleteConfirmId(null);\r\n  }\r\n\r\n  function toggleSort(field: SortField) {\r\n    if (sortField === field) {\r\n      setSortOrder(sortOrder === \"asc\" ? \"desc\" : \"asc\");\r\n    } else {\r\n      setSortField(field);\r\n      setSortOrder(\"asc\");\r\n    }\r\n  }\r\n\r\n  return (\r\n    <div className=\"min-h-screen bg-black pb-32 w-full max-w-[100vw] overflow-x-hidden\">\r\n      <div className=\"max-w-[1400px] mx-auto w-full\">\r\n        {/* Sticky header with search, sort, view toggle */}\r\n        <div className=\"sticky top-0 z-20 bg-black/95 backdrop-blur-sm px-4 py-4 border-b border-zinc-800\">\r\n          <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4\">\r\n            <div>\r\n              <h1 className=\"text-3xl font-bold bg-gradient-to-r from-[#E52C2C] to-[#a20707] bg-clip-text text-transparent\">\r\n                Playlists\r\n              </h1>\r\n              <p className=\"text-sm text-zinc-500 mt-1\">\r\n                {playlists?.length || 0} collection\r\n                {playlists?.length !== 1 ? \"s\" : \"\"}\r\n              </p>\r\n            </div>\r\n            <div className=\"flex gap-2\">\r\n              {/* View toggle buttons */}\r\n              <div className=\"flex bg-zinc-900 rounded-xl p-0.5\">\r\n                <button\r\n                  onClick={() => setViewMode(\"grid\")}\r\n                  className={`px-3 py-1.5 rounded-lg transition ${\r\n                    viewMode === \"grid\"\r\n                      ? \"bg-[#E52C2C] text-white\"\r\n                      : \"text-zinc-400 hover:text-white\"\r\n                  }`}\r\n                  title=\"Grid view\"\r\n                >\r\n                  <LayoutGrid size={18} />\r\n                </button>\r\n                <button\r\n                  onClick={() => setViewMode(\"list\")}\r\n                  className={`px-3 py-1.5 rounded-lg transition ${\r\n                    viewMode === \"list\"\r\n                      ? \"bg-[#E52C2C] text-white\"\r\n                      : \"text-zinc-400 hover:text-white\"\r\n                  }`}\r\n                  title=\"List view\"\r\n                >\r\n                  <List size={18} />\r\n                </button>\r\n              </div>\r\n              <button\r\n                onClick={() => setIsCreateModalOpen(true)}\r\n                className=\"h-10 px-4 rounded-xl bg-[#E52C2C] text-white flex items-center gap-2 hover:scale-105 transition active:scale-95\"\r\n              >\r\n                <Plus size={18} />\r\n                Create\r\n              </button>\r\n            </div>\r\n          </div>\r\n\r\n          {/* Search & Sort Bar */}\r\n          <div className=\"flex flex-col sm:flex-row gap-3 mt-4\">\r\n            <div className=\"relative flex-1\">\r\n              <Search\r\n                size={16}\r\n                className=\"absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500\"\r\n              />\r\n              <input\r\n                type=\"text\"\r\n                value={search}\r\n                onChange={(e) => setSearch(e.target.value)}\r\n                placeholder=\"Search playlists...\"\r\n                className=\"w-full h-10 bg-zinc-900 rounded-xl pl-9 pr-4 text-sm border border-zinc-800 focus:border-[#E52C2C] outline-none transition\"\r\n              />\r\n            </div>\r\n            <div className=\"flex gap-2\">\r\n              <button\r\n                onClick={() => toggleSort(\"name\")}\r\n                className={`px-3 h-10 rounded-xl text-sm transition ${\r\n                  sortField === \"name\"\r\n                    ? \"bg-[#E52C2C] text-white\"\r\n                    : \"bg-zinc-900 text-zinc-400\"\r\n                }`}\r\n              >\r\n                Name {sortField === \"name\" && (sortOrder === \"asc\" ? \"↑\" : \"↓\")}\r\n              </button>\r\n              <button\r\n                onClick={() => toggleSort(\"count\")}\r\n                className={`px-3 h-10 rounded-xl text-sm transition ${\r\n                  sortField === \"count\"\r\n                    ? \"bg-[#E52C2C] text-white\"\r\n                    : \"bg-zinc-900 text-zinc-400\"\r\n                }`}\r\n              >\r\n                Songs{\" \"}\r\n                {sortField === \"count\" && (sortOrder === \"asc\" ? \"↑\" : \"↓\")}\r\n              </button>\r\n              <button\r\n                onClick={() => toggleSort(\"updated\")}\r\n                className={`px-3 h-10 rounded-xl text-sm transition ${\r\n                  sortField === \"updated\"\r\n                    ? \"bg-[#E52C2C] text-white\"\r\n                    : \"bg-zinc-900 text-zinc-400\"\r\n                }`}\r\n              >\r\n                Recent{\" \"}\r\n                {sortField === \"updated\" && (sortOrder === \"asc\" ? \"↑\" : \"↓\")}\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        {/* Main content: Grid or List */}\r\n        <div className=\"px-4 py-6\">\r\n          {filteredPlaylists.length === 0 ? (\r\n            <div className=\"flex flex-col items-center justify-center py-20 text-center\">\r\n              <div className=\"w-24 h-24 rounded-3xl bg-zinc-900 flex items-center justify-center mb-5 border border-zinc-800\">\r\n                <Music2 size={38} className=\"text-[#E52C2C]\" />\r\n              </div>\r\n              <h2 className=\"font-semibold text-lg\">\r\n                {search ? \"No matching playlists\" : \"No playlists yet\"}\r\n              </h2>\r\n              <p className=\"text-sm text-zinc-500 mt-2 max-w-xs leading-relaxed\">\r\n                {search\r\n                  ? \"Try a different search term\"\r\n                  : \"Create playlists to organize your imported music and build your own listening experience\"}\r\n              </p>\r\n              {!search && (\r\n                <button\r\n                  onClick={() => setIsCreateModalOpen(true)}\r\n                  className=\"mt-6 px-5 h-10 rounded-full bg-[#E52C2C] text-white flex items-center gap-2\"\r\n                >\r\n                  <Plus size={16} /> Create first playlist\r\n                </button>\r\n              )}\r\n            </div>\r\n          ) : viewMode === \"grid\" ? (\r\n            // Grid view\r\n            <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3\">\r\n              {filteredPlaylists.map((playlist) => (\r\n                <div\r\n                  key={playlist.id}\r\n                  className=\"group relative bg-zinc-900/50 rounded-xl border border-zinc-800 hover:border-zinc-700 transition-all hover:scale-[1.02] hover:shadow-lg\"\r\n                >\r\n                  <Link\r\n                    href={`/playlists/playlist?id=${playlist.id}`}\r\n                    className=\"block p-2.5\"\r\n                  >\r\n                    <div className=\"aspect-square rounded-lg overflow-hidden bg-gradient-to-br from-[#E52C2C] to-[#a20707] mb-2 shadow-md\">\r\n                      {playlist.cover ? (\r\n                        <img\r\n                          src={playlist.cover}\r\n                          alt={playlist.name}\r\n                          className=\"w-full h-full object-cover\"\r\n                        />\r\n                      ) : (\r\n                        <div className=\"w-full h-full flex items-center justify-center\">\r\n                          <Music2 size={32} className=\"text-white/80\" />\r\n                        </div>\r\n                      )}\r\n                    </div>\r\n                    <h3 className=\"font-medium text-sm truncate\">\r\n                      {playlist.name}\r\n                    </h3>\r\n                    <p className=\"text-xs text-zinc-500 mt-0.5\">\r\n                      {playlist.songCount}{\" \"}\r\n                      {playlist.songCount === 1 ? \"song\" : \"songs\"}\r\n                    </p>\r\n                    {playlist.description && (\r\n                      <p className=\"text-[11px] text-zinc-400 mt-1 line-clamp-2\">\r\n                        {playlist.description}\r\n                      </p>\r\n                    )}\r\n                  </Link>\r\n                  <div className=\"absolute top-1.5 right-1.5 opacity-0 group-hover:opacity-100 transition\">\r\n                    <button\r\n                      onClick={(e) => {\r\n                        e.preventDefault();\r\n                        setEditingPlaylist(playlist);\r\n                      }}\r\n                      className=\"w-7 h-7 rounded-full bg-black/50 backdrop-blur-sm flex items-center justify-center hover:bg-black/70\"\r\n                    >\r\n                      <MoreVertical size={12} />\r\n                    </button>\r\n                  </div>\r\n                </div>\r\n              ))}\r\n            </div>\r\n          ) : (\r\n            // List view - cleaner, table-like rows\r\n            <div className=\"space-y-2\">\r\n              {filteredPlaylists.map((playlist) => (\r\n                <div\r\n                  key={playlist.id}\r\n                  className=\"group flex items-center gap-4 p-3 rounded-xl bg-zinc-900/30 border border-zinc-800 hover:bg-zinc-900/70 transition-all\"\r\n                >\r\n                  <Link\r\n                    href={`/playlists/playlist?id=${playlist.id}`}\r\n                    className=\"flex items-center gap-4 flex-1 min-w-0\"\r\n                  >\r\n                    <div className=\"w-12 h-12 rounded-lg overflow-hidden bg-gradient-to-br from-[#E52C2C] to-[#a20707] flex-shrink-0 shadow\">\r\n                      {playlist.cover ? (\r\n                        <img\r\n                          src={playlist.cover}\r\n                          alt={playlist.name}\r\n                          className=\"w-full h-full object-cover\"\r\n                        />\r\n                      ) : (\r\n                        <div className=\"w-full h-full flex items-center justify-center\">\r\n                          <Music2 size={20} className=\"text-white/70\" />\r\n                        </div>\r\n                      )}\r\n                    </div>\r\n                    <div className=\"min-w-0 flex-1\">\r\n                      <h3 className=\"font-medium truncate\">{playlist.name}</h3>\r\n                      <div className=\"flex gap-3 text-xs text-zinc-500\">\r\n                        <span>{playlist.songCount} songs</span>\r\n                        {playlist.updatedAt && (\r\n                          <span>\r\n                            Updated{\" \"}\r\n                            {new Date(playlist.updatedAt).toLocaleDateString(\r\n                              undefined,\r\n                              {\r\n                                month: \"short\",\r\n                                day: \"numeric\",\r\n                              },\r\n                            )}\r\n                          </span>\r\n                        )}\r\n                      </div>\r\n                      {playlist.description && (\r\n                        <p className=\"text-xs text-zinc-500 truncate mt-0.5\">\r\n                          {playlist.description}\r\n                        </p>\r\n                      )}\r\n                    </div>\r\n                  </Link>\r\n                  <button\r\n                    onClick={() => setEditingPlaylist(playlist)}\r\n                    className=\"opacity-0 group-hover:opacity-100 transition p-2 rounded-lg hover:bg-zinc-800\"\r\n                  >\r\n                    <MoreVertical size={16} className=\"text-zinc-400\" />\r\n                  </button>\r\n                </div>\r\n              ))}\r\n            </div>\r\n          )}\r\n        </div>\r\n      </div>\r\n\r\n      {/* Create/Edit Modal (unchanged, but improved styling) */}\r\n      {(isCreateModalOpen || editingPlaylist) && (\r\n        <div className=\"fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] flex items-center justify-center p-4\">\r\n          <div className=\"bg-zinc-950 rounded-2xl max-w-md w-full p-6 border border-zinc-800 animate-in zoom-in duration-200\">\r\n            <div className=\"flex justify-between items-center mb-4\">\r\n              <h2 className=\"text-xl font-bold\">\r\n                {editingPlaylist ? \"Edit Playlist\" : \"Create Playlist\"}\r\n              </h2>\r\n              <button\r\n                onClick={() => {\r\n                  setIsCreateModalOpen(false);\r\n                  setEditingPlaylist(null);\r\n                  setNewName(\"\");\r\n                  setNewCover(undefined);\r\n                  setNewDescription(\"\");\r\n                }}\r\n                className=\"text-zinc-500 hover:text-white\"\r\n              >\r\n                <X size={20} />\r\n              </button>\r\n            </div>\r\n\r\n            {/* Cover upload */}\r\n            <div className=\"mb-4\">\r\n              <label className=\"block text-sm text-zinc-400 mb-2\">\r\n                Cover image (optional)\r\n              </label>\r\n              <div className=\"flex gap-3 items-center\">\r\n                <div className=\"w-20 h-20 rounded-xl overflow-hidden bg-zinc-900 border border-zinc-800\">\r\n                  {newCover || editingPlaylist?.cover ? (\r\n                    <img\r\n                      src={newCover || editingPlaylist?.cover}\r\n                      alt=\"cover\"\r\n                      className=\"w-full h-full object-cover\"\r\n                    />\r\n                  ) : (\r\n                    <div className=\"w-full h-full flex items-center justify-center\">\r\n                      <ImageIcon size={24} className=\"text-zinc-600\" />\r\n                    </div>\r\n                  )}\r\n                </div>\r\n                <input\r\n                  type=\"file\"\r\n                  accept=\"image/*\"\r\n                  onChange={(e) => {\r\n                    const file = e.target.files?.[0];\r\n                    if (file) {\r\n                      const reader = new FileReader();\r\n                      reader.onload = (ev) => {\r\n                        const base64 = ev.target?.result as string;\r\n                        if (editingPlaylist) {\r\n                          updatePlaylist(editingPlaylist, { cover: base64 });\r\n                        } else {\r\n                          setNewCover(base64);\r\n                        }\r\n                      };\r\n                      reader.readAsDataURL(file);\r\n                    }\r\n                  }}\r\n                  className=\"text-sm text-zinc-400 file:mr-2 file:py-1 file:px-3 file:rounded-full file:border-0 file:text-sm file:bg-zinc-800 file:text-white hover:file:bg-zinc-700\"\r\n                />\r\n              </div>\r\n            </div>\r\n\r\n            {/* Name */}\r\n            <input\r\n              autoFocus\r\n              value={editingPlaylist ? editingPlaylist.name : newName}\r\n              onChange={(e) => {\r\n                if (editingPlaylist) {\r\n                  setEditingPlaylist({\r\n                    ...editingPlaylist,\r\n                    name: e.target.value,\r\n                  });\r\n                } else {\r\n                  setNewName(e.target.value);\r\n                }\r\n              }}\r\n              placeholder=\"Playlist name\"\r\n              className=\"w-full h-12 bg-zinc-900 rounded-xl px-4 outline-none border border-zinc-800 focus:border-[#E52C2C] mb-4\"\r\n            />\r\n\r\n            {/* Description */}\r\n            <textarea\r\n              value={\r\n                editingPlaylist\r\n                  ? editingPlaylist.description || \"\"\r\n                  : newDescription\r\n              }\r\n              onChange={(e) => {\r\n                if (editingPlaylist) {\r\n                  setEditingPlaylist({\r\n                    ...editingPlaylist,\r\n                    description: e.target.value,\r\n                  });\r\n                } else {\r\n                  setNewDescription(e.target.value);\r\n                }\r\n              }}\r\n              placeholder=\"Description (optional)\"\r\n              rows={3}\r\n              className=\"w-full bg-zinc-900 rounded-xl px-4 py-2 outline-none border border-zinc-800 focus:border-[#E52C2C] mb-4 resize-none\"\r\n            />\r\n\r\n            <div className=\"flex gap-3\">\r\n              <button\r\n                onClick={() => {\r\n                  if (editingPlaylist) {\r\n                    updatePlaylist(editingPlaylist, {\r\n                      name: editingPlaylist.name,\r\n                      description: editingPlaylist.description,\r\n                    });\r\n                    setEditingPlaylist(null);\r\n                  } else {\r\n                    createPlaylist();\r\n                  }\r\n                }}\r\n                className=\"flex-1 h-11 rounded-xl bg-[#E52C2C] text-white font-medium\"\r\n              >\r\n                {editingPlaylist ? \"Save Changes\" : \"Create\"}\r\n              </button>\r\n              {editingPlaylist && (\r\n                <button\r\n                  onClick={() => setEditingPlaylist(null)}\r\n                  className=\"flex-1 h-11 rounded-xl bg-zinc-800 text-white\"\r\n                >\r\n                  Cancel\r\n                </button>\r\n              )}\r\n            </div>\r\n\r\n            {editingPlaylist && (\r\n              <button\r\n                onClick={() => {\r\n                  setDeleteConfirmId(editingPlaylist.id);\r\n                  setEditingPlaylist(null);\r\n                }}\r\n                className=\"w-full mt-3 h-10 rounded-xl text-red-400 hover:bg-red-500/10 transition\"\r\n              >\r\n                Delete Playlist\r\n              </button>\r\n            )}\r\n          </div>\r\n        </div>\r\n      )}\r\n\r\n      {/* Delete Confirmation Modal (unchanged) */}\r\n      {deleteConfirmId && (\r\n        <div className=\"fixed inset-0 bg-black/80 backdrop-blur-sm z-[101] flex items-center justify-center p-4\">\r\n          <div className=\"bg-zinc-950 rounded-2xl max-w-sm w-full p-6 border border-zinc-800\">\r\n            <h3 className=\"text-lg font-bold mb-2\">Delete Playlist?</h3>\r\n            <p className=\"text-sm text-zinc-400 mb-6\">\r\n              This action cannot be undone. The playlist will be permanently\r\n              removed.\r\n            </p>\r\n            <div className=\"flex gap-3\">\r\n              <button\r\n                onClick={() => setDeleteConfirmId(null)}\r\n                className=\"flex-1 h-10 rounded-xl bg-zinc-800 text-white\"\r\n              >\r\n                Cancel\r\n              </button>\r\n              <button\r\n                onClick={() => deletePlaylist(deleteConfirmId)}\r\n                className=\"flex-1 h-10 rounded-xl bg-red-600 text-white\"\r\n              >\r\n                Delete\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n"}