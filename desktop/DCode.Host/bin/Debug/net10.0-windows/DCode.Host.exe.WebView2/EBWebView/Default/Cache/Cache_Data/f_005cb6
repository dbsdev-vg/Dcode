u003E\\n          \\u003Cdiv style={{ padding: \\u002716px\\u0027 }}\\u003E\\n            {recentActivities.map((activity) =\\u003E (\\n              \\u003Cdiv key={activity.id} style={{ padding: \\u002712px 0\\u0027, borderBottom: \\u00271px solid var(--border)\\u0027, display: \\u0027flex\\u0027, justifyContent: \\u0027space-between\\u0027, alignItems: \\u0027center\\u0027 }}\\u003E\\n                \\u003Cdiv\\u003E\\n                  \\u003Cdiv style={{ fontWeight: \\u0027500\\u0027 }}\\u003E{activity.action}\\u003C/div\\u003E\\n                  \\u003Cdiv style={{ fontSize: \\u00270.875rem\\u0027, color: \\u0027var(--muted-foreground)\\u0027 }}\\u003Epor {activity.user}\\u003C/div\\u003E\\n                \\u003C/div\\u003E\\n                \\u003Cspan style={{ fontSize: \\u00270.875rem\\u0027, color: \\u0027var(--muted-foreground)\\u0027 }}\\u003E{activity.timestamp}\\u003C/span\\u003E\\n              \\u003C/div\\u003E\\n            ))}\\n          \\u003C/div\\u003E\\n        \\u003C/ViewportFrame\\u003E\\n      \\u003C/section\\u003E\\n    \\u003C/div\\u003E\\n  );\\n}\\n\"}}","timestamp":"2026-08-28T13:01:41.2846808+00:00"},{"id":"130c3a550d02471b816b564f07ec68d4:tool-completed:1","stage":"tool_completed","label":"Writing src/sections/DashboardSection.tsx","status":"completed","durationMilliseconds":1430,"detail":"{\"toolId\":\"filesystem.write\",\"arguments\":{\"path\":\"src/sections/DashboardSection.tsx\",\"content\":\"import {\\n  Stat,\\n  Table,\\n  TableContainer,\\n  TableHeader,\\n  TableBody,\\n  TableRow,\\n  TableHead,\\n  TableCell,\\n  TableCaption,\\n  Badge,\\n  type BadgeVariant,\\n  Button,\\n  Card,\\n  CardHeader,\\n  CardTitle,\\n  CardContent,\\n} from \\u0022@dbs-studio/ui\\u0022;\\nimport { useSettings } from \\u0022../settings/SettingsContext\\u0022;\\nimport { ViewportFrame } from \\u0022../components/ViewportFrame\\u0022;\\nimport { FORNECEDORES, formatBRL as formatBRLFornecedor } from \\u0022../mock/fornecedores\\u0022;\\nimport { PRODUTOS } from \\u0022../mock/produtos\\u0022;\\nimport { CLIENTES } from \\u0022../mock/clientes\\u0022;\\nimport { PEDIDOS, type StatusPedido } from \\u0022../mock/pedidos\\u0022;\\nimport { Plus, Truck, Upload, FileDown, Bell, Clock } from \\u0022lucide-react\\u0022;\\n\\nconst formatBRL = (value: number): string =\\u003E\\n  new Intl.NumberFormat(\\u0022pt-BR\\u0022, { style: \\u0022currency\\u0022, currency: \\u0022BRL\\u0022 }).format(value);\\n\\nconst STATUS_VARIANT: Record\\u003CStatusPedido, BadgeVariant\\u003E = {\\n  Entregue: \\u0022success\\u0022,\\n  Pendente: \\u0022warning\\u0022,\\n  Cancelado: \\u0022destructive\\u0022,\\n  \\u0022Em andamento\\u0022: \\u0022info\\u0022,\\n};\\n\\n// Helper to parse date from dd/mm/yyyy\\nconst parseDate = (dateStr: string): Date =\\u003E {\\n  const [day, month, year] = dateStr.split(\\u0022/\\u0022).map(Number);\\n  return new Date(year, month - 1, day);\\n};\\n\\n// Helper to get month/year from date\\nconst getMonthYear = (dateStr: string): string =\\u003E {\\n  const date = parseDate(dateStr);\\n  return \\u0060${date.getMonth() \\u002B 1}/${date.getFullYear()}\\u0060;\\n};\\n\\nexport function DashboardSection() {\\n  const { settings } = useSettings();\\n\\n  const totalFornecedores = FORNECEDORES.length;\\n  const totalProdutos = PRODUTOS.length;\\n  const totalClientes = CLIENTES.length;\\n  const totalPedidos = PEDIDOS.length;\\n\\n  // Calculate revenue metrics\\n  const totalRevenue = PEDIDOS.reduce((sum, p) =\\u003E sum \\u002B p.total, 0);\\n  const avgOrderValue = totalPedidos \\u003E 0 ? totalRevenue / totalPedidos : 0;\\n\\n  // Monthly revenue (current month)\\n  const currentDate = new Date();\\n  const currentMonth = currentDate.getMonth();\\n  const currentYear = currentDate.getFullYear();\\n\\n  const currentMonthOrders = PEDIDOS.filter(p =\\u003E {\\n    const date = parseDate(p.data);\\n    return date.getMonth() === currentMonth \\u0026\\u0026 date.getFullYear() === currentYear;\\n  });\\n\\n  const currentMonthRevenue = currentMonthOrders.reduce((sum, p) =\\u003E sum \\u002B p.total, 0);\\n  const currentMonthOrdersCount = currentMonthOrders.length;\\n\\n  // Previous month revenue\\n  const prevMonth = currentMonth === 0 ? 11 : currentMonth - 1;\\n  const prevYear = currentMonth === 0 ? currentYear - 1 : currentYear;\\n  const prevMonthOrders = PEDIDOS.filter(p =\\u003E {\\n    const date = parseDate(p.data);\\n    return date.getMonth() === prevMonth \\u0026\\u0026 date.getFullYear() === prevYear;\\n  });\\n  const prevMonthRevenue = prevMonthOrders.reduce((sum, p) =\\u003E sum \\u002B p.total, 0);\\n\\n  const revenueChange = prevMonthRevenue \\u003E 0 \\n    ? ((currentMonthRevenue - prevMonthRevenue) / prevMonthRevenue) * 100 \\n    : 0;\\n\\n  // Order status breakdown\\n  const statusCounts: Record\\u003CStatusPedido, number\\u003E = {\\n    Entregue: 0,\\n    Pendente: 0,\\n    Cancelado: 0,\\n    \\u0022Em andamento\\u0022: 0,\\n  };\\n  PEDIDOS.forEach(p =\\u003E statusCounts[p.status]\\u002B\\u002B);\\n\\n  // Top clients\\n  const topClientes = [...CLIENTES]\\n    .sort((a, b) =\\u003E b.totalCompras - a.totalCompras)\\n    .slice(0, 5);\\n\\n  // Top suppliers\\n  const topFornecedores = [...FORNECEDORES]\\n    .sort((a, b) =\\u003E b.valor - a.valor)\\n    .slice(0, 5);\\n\\n  // Low stock items (estoque \\u003C 50)\\n  const lowStockItems = PRODUTOS.filter(p =\\u003E p.estoque \\u003C 50 \\u0026\\u0026 p.status === \\u0022Ativo\\u0022);\\n\\n  // Pending orders\\n  const pendingOrders = PEDIDOS.filter(p =\\u003E p.status === \\u0022Pendente\\u0022);\\n\\n  // Recent activity feed (mock data)\\n  const recentActivities = [\\n    { id: 1, action: \\u0022Novo pedido #35 criado\\u0022, timestamp: \\u00225 min atr\\u00E1s\\u0022, user: \\u0022Jo\\u00E3o Silva\\u0022 },\\n    { id: 2, action: \\u0022Produto \\u0027Caf\\u00E9 Gourmet\\u0027 atualizado\\u0022, timestamp: \\u002218 min atr\\u00E1s\\u0022, user: \\u0022Maria Oliveira\\u0022 },\\n    { id: 3, action: \\u0022Fornecedor \\u0027Metal\\u00FArgica Paulista\\u0027 adicionado\\u0022, timestamp: \\u00221 hora atr\\u00E1s\\u0022, user: \\u0022Carlos Souza\\u0022 },\\n    { id: 4, action: \\u0022Pedido #28 entregue com sucesso\\u0022, timestamp: \\u00222 horas atr\\u00E1s\\u0022, user: \\u0022Ana Pereira\\u0022 },\\n    { id: 5, action: \\u0022Cliente \\u0027Supermercados Dias\\u0027 atualizado\\u0022, timestamp: \\u00223 horas atr\\u00E1s\\u0022, user: \\u0022Roberto Lima\\u0022 },\\n    { id: 6, action: \\u0022Novo produto \\u0027Monitor LED 24\\u0027 adicionado\\u0022, timestamp: \\u00225 horas atr\\u00E1s\\u0022, user: \\u0022Fernanda Costa\\u0022 },\\n  ];\\n\\n  // Get 10 most recent orders\\n  const recentOrders = [...PEDIDOS].sort((a, b) =\\u003E {\\n    const aDate = parseDate(a.data);\\n    const bDate = parseDate(b.data);\\n    return bDate.getTime() - aDate.getTime();\\n  }).slice(0, 10);\\n\\n  // Status distribution for visualization (simple progress bars)\\n  const statusPercentages = Object.entries(statusCounts).map(([status, count]) =\\u003E ({\\n    status,\\n    count,\\n    percentage: totalPedidos \\u003E 0 ? (count / totalPedidos) * 100 : 0,\\n  }));\\n\\n  return (\\n    \\u003Cdiv className=\\u0022sections\\u0022\\u003E\\n      {/* Header */}\\n      \\u003Csection className=\\u0022section\\u0022\\u003E\\n        \\u003Ch2 className=\\u0022section__title\\u0022\\u003EDashboard\\u003C/h2\\u003E\\n        \\u003Cp className=\\u0022section__description\\u0022\\u003E\\n          Vis\\u00E3o geral dos dados do sistema com resumos e indicadores\\n        \\u003C/p\\u003E\\n\\n        {/* Quick Action Buttons */}\\n        \\u003Cdiv style={{ display: \\u0027flex\\u0027, gap: \\u00278px\\u0027, marginBottom: \\u002724px\\u0027, flexWrap: \\u0027wrap\\u0027 }}\\u003E\\n          \\u003CButton size=\\u0022sm\\u0022\\u003E\\u003CPlus size={16} /\\u003E Novo pedido\\u003C/Button\\u003E\\n          \\u003CButton size=\\u0022sm\\u0022 variant=\\u0022outline\\u0022\\u003E\\u003CTruck size={16} /\\u003E Cadastrar fornecedor\\u003C/Button\\u003E\\n          \\u003CButton size=\\u0022sm\\u0022 variant=\\u0022outline\\u0022\\u003E\\u003CUpload size={16} /\\u003E Importar dados\\u003C/Button\\u003E\\n          \\u003CButton size=\\u0022sm\\u0022 variant=\\u0022outline\\u0022\\u003E\\u003CFileDown size={16} /\\u003E Exportar relat\\u00F3rio\\u003C/Button\\u003E\\n        \\u003C/div\\u003E\\n\\n        {/* KPI Metrics */}\\n        \\u003Cdiv className=\\u0022stat-row\\u0022\\u003E\\n          \\u003CStat\\n            label=\\u0022Receita do m\\u00EAs\\u0022\\n            value={formatBRL(currentMonthRevenue)}\\n            trend={revenueChange \\u003E 0 ? \\u0060\\u002B${revenueChange.toFixed(1)}%\\u0060 : \\u0060${revenueChange.toFixed(1)}%\\u0060}\\n            trendDirection={revenueChange \\u003E= 0 ? \\u0022up\\u0022 : \\u0022down\\u0022}\\n            trendIntent={revenueChange \\u003E= 0 ? \\u0022good\\u0022 : \\u0022bad\\u0022}\\n            hint={\\u0060vs. m\\u00EAs passado (${formatBRL(prevMonthRevenue)})\\u0060}\\n            grow\\n          /\\u003E\\n          \\u003CStat\\n            label=\\u0022Valor m\\u00E9dio do pedido\\u0022\\n            value={formatBRL(avgOrderValue)}\\n            hint={\\u0060${totalPedidos} pedidos\\u0060}\\n            grow\\n          /\\u003E\\n          \\u003CStat\\n            label=\\u0022Pedidos este m\\u00EAs\\u0022\\n            value={currentMonthOrdersCount.toString()}\\n            hint={\\u0060${totalPedidos} total\\u0060}\\n            grow\\n          /\\u003E\\n          \\u003CStat\\n            label=\\u0022Taxa de conclus\\u00E3o\\u0022\\n            value={\\u0060${totalPedidos \\u003E 0 ? ((statusCounts.Entregue / totalPedidos) * 100).toFixed(0) : 0}%\\u0060}\\n            hint={\\u0060${statusCounts.Entregue} entregues\\u0060}\\n            grow\\n          /\\u003E\\n        \\u003C/div\\u003E\\n\\n        {/* Additional KPIs */}\\n        \\u003Cdiv className=\\u0022stat-row\\u0022\\u003E\\n          \\u003CStat\\n            label=\\u0022Clientes ativos\\u0022\\n            value={CLIENTES.filter(c =\\u003E c.status === \\u0022Ativo\\u0022).length.toString()}\\n            hint={\\u0060${totalClientes} total\\u0060}\\n            grow\\n          /\\u003E\\n          \\u003CStat\\n            label=\\u0022Fornecedores ativos\\u0022\\n            value={FORNECEDORES.filter(f =\\u003E f.status === \\u0022Ativo\\u0022).length.toString()}\\n            hint={\\u0060${totalFornecedores} total\\u0060}\\n            grow\\n          /\\u003E\\n          \\u003CStat\\n            label=\\u0022Produtos em falta\\u0022\\n            value={PRODUTOS.filter(p =\\u003E p.status === \\u0022Em falta\\u0022).length.toString()}\\n            hint=\\u0022precisa reabastecer\\u0022\\n            grow\\n          /\\u003E\\n          \\u003CStat\\n            label=\\u0022Ticket m\\u00E9dio mensal\\u0022\\n            value={formatBRL(currentMonthOrdersCount \\u003E 0 ? currentMonthRevenue / currentMonthOrdersCount : 0)}\\n            hint=\\u0022por pedido\\u0022\\n            grow\\n          /\\u003E\\n        \\u003C/div\\u003E\\n      \\u003C/section\\u003E\\n\\n      {/* Status Breakdown */}\\n      \\u003Csection className=\\u0022section\\u0022\\u003E\\n        \\u003Ch2 className=\\u0022section__title\\u0022\\u003EStatus dos pedidos\\u003C/h2\\u003E\\n        \\u003Cp className=\\u0022section__description\\u0022\\u003EDistribui\\u00E7\\u00E3o de pedidos por status\\u003C/p\\u003E\\n        \\u003Cdiv style={{ display: \\u0027grid\\u0027, gridTemplateColumns: \\u0027repeat(auto-fit, minmax(200px, 1fr))\\u0027, gap: \\u002716px\\u0027 }}\\u003E\\n          {statusPercentages.map(({ status, count, percentage }) =\\u003E (\\n            \\u003Cdiv key={status} style={{ padding: \\u002716px\\u0027, background: \\u0027var(--card-background)\\u0027, borderRadius: \\u00278px\\u0027, border: \\u00271px solid var(--border)\\u0027 }}\\u003E\\n              \\u003Cdiv style={{ display: \\u0027flex\\u0027, justifyContent: \\u0027space-between\\u0027, marginBottom: \\u00278px\\u0027 }}\\u003E\\n                \\u003CBadge variant={STATUS_VARIANT[status as StatusPedido]}\\u003E{status}\\u003C/Badge\\u003E\\n                \\u003Cspan style={{ fontWeight: \\u0027bold\\u0027 }}\\u003E{count}\\u003C/span\\u003E\\n              \\u003C/div\\u003E\\n              \\u003Cdiv style={{ width: \\u0027100%\\u0027, height: \\u00278px\\u0027, background: \\u0027var(--background)\\u0027, borderRadius: \\u00274px\\u0027, overflow: \\u0027hidden\\u0027 }}\\u003E\\n                \\u003Cdiv style={{ width: \\u0060${percentage}%\\u0060, height: \\u0027100%\\u0027, background: \\u0027var(--primary)\\u0027, borderRadius: \\u00274px\\u0027 }} /\\u003E\\n              \\u003C/div\\u003E\\n              \\u003Cspan style={{ fontSize: \\u00270.875rem\\u0027, color: \\u0027var(--muted-foreground)\\u0027 }}\\u003E{percentage.toFixed(1)}%\\u003C/span\\u003E\\n            \\u003C/div\\u003E\\n          ))}\\n        \\u003C/div\\u003E\\n      \\u003C/section\\u003E\\n\\n      {/* Alerts */}\\n      \\u003Csection className=\\u0022section\\u0022\\u003E\\n        \\u003Ch2 className=\\u0022section__title\\u0022\\u003EAlertas \\u003CBell size={16} style={{ display: \\u0027inline\\u0027, verticalAlign: \\u0027middle\\u0027 }} /\\u003E\\u003C/h2\\u003E\\n        \\u003Cp className=\\u0022section__description\\u0022\\u003EItens que requerem aten\\u00E7\\u00E3o\\u003C/p\\u003E\\n        \\u003Cdiv style={{ display: \\u0027grid\\u0027, gridTemplateColumns: \\u0027repeat(auto-fit, minmax(300px, 1fr))\\u0027, gap: \\u002716px\\u0027 }}\\u003E\\n          \\u003CCard\\u003E\\n            \\u003CCardHeader\\u003E\\n              \\u003CCardTitle\\u003EEstoque baixo ({lowStockItems.length})\\u003C/CardTitle\\u003E\\n            \\u003C/CardHeader\\u003E\\n            \\u003CCardContent\\u003E\\n              {