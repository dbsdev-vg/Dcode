hboardSection.tsx\"},\"result\":{\"Success\":true,\"Output\":{\"path\":\"src\\\\sections\\\\DashboardSection.tsx\",\"content\":\"import {\\n  Stat,\\n  Table,\\n  TableContainer,\\n  TableHeader,\\n  TableBody,\\n  TableRow,\\n  TableHead,\\n  TableCell,\\n  TableCaption,\\n  Badge,\\n  type BadgeVariant,\\n} from \\u0022@dbs-studio/ui\\u0022;\\nimport { useSettings } from \\u0022../settings/SettingsContext\\u0022;\\nimport { ViewportFrame } from \\u0022../components/ViewportFrame\\u0022;\\nimport { FORNECEDORES } from \\u0022../mock/fornecedores\\u0022;\\nimport { PRODUTOS } from \\u0022../mock/produtos\\u0022;\\nimport { CLIENTES } from \\u0022../mock/clientes\\u0022;\\nimport { PEDIDOS, type StatusPedido } from \\u0022../mock/pedidos\\u0022;\\n\\nconst formatBRL = (value: number): string =\\u003E\\n  new Intl.NumberFormat(\\u0022pt-BR\\u0022, { style: \\u0022currency\\u0022, currency: \\u0022BRL\\u0022 }).format(value);\\n\\nconst STATUS_VARIANT: Record\\u003CStatusPedido, BadgeVariant\\u003E = {\\n  Entregue: \\u0022success\\u0022,\\n  Pendente: \\u0022warning\\u0022,\\n  Cancelado: \\u0022destructive\\u0022,\\n  \\u0022Em andamento\\u0022: \\u0022info\\u0022,\\n};\\n\\nexport function DashboardSection() {\\n  const { settings } = useSettings();\\n\\n  const totalFornecedores = FORNECEDORES.length;\\n  const totalProdutos = PRODUTOS.length;\\n  const totalClientes = CLIENTES.length;\\n  const totalPedidos = PEDIDOS.length;\\n\\n  // Get 10 most recent orders\\n  const recentOrders = [...PEDIDOS].sort((a, b) =\\u003E {\\n    // Simple date comparison (dd/mm/yyyy)\\n    const [aDay, aMonth, aYear] = a.data.split(\\u0022/\\u0022).map(Number);\\n    const [bDay, bMonth, bYear] = b.data.split(\\u0022/\\u0022).map(Number);\\n    const aDate = new Date(aYear, aMonth - 1, aDay);\\n    const bDate = new Date(bYear, bMonth - 1, bDay);\\n    return bDate.getTime() - aDate.getTime();\\n  }).slice(0, 10);\\n\\n  return (\\n    \\u003Cdiv className=\\u0022sections\\u0022\\u003E\\n      \\u003Csection className=\\u0022section\\u0022\\u003E\\n        \\u003Ch2 className=\\u0022section__title\\u0022\\u003EDashboard\\u003C/h2\\u003E\\n        \\u003Cp className=\\u0022section__description\\u0022\\u003E\\n          Vis\\u00E3o geral dos dados do sistema com resumos e indicadores\\n        \\u003C/p\\u003E\\n\\n        \\u003Cdiv className=\\u0022stat-row\\u0022\\u003E\\n          \\u003CStat\\n            label=\\u0022Fornecedores\\u0022\\n            value={totalFornecedores.toString()}\\n            hint=\\u0022cadastrados\\u0022\\n            grow\\n          /\\u003E\\n          \\u003CStat\\n            label=\\u0022Produtos\\u0022\\n            value={totalProdutos.toString()}\\n            hint=\\u0022em estoque\\u0022\\n            grow\\n          /\\u003E\\n          \\u003CStat\\n            label=\\u0022Clientes\\u0022\\n            value={totalClientes.toString()}\\n            hint=\\u0022ativos\\u0022\\n            grow\\n          /\\u003E\\n          \\u003CStat\\n            label=\\u0022Pedidos\\u0022\\n            value={totalPedidos.toString()}\\n            hint=\\u0022total\\u0022\\n            grow\\n          /\\u003E\\n        \\u003C/div\\u003E\\n      \\u003C/section\\u003E\\n\\n      \\u003Csection className=\\u0022section\\u0022\\u003E\\n        \\u003Ch2 className=\\u0022section__title\\u0022\\u003EPedidos recentes\\u003C/h2\\u003E\\n        \\u003Cp className=\\u0022section__description\\u0022\\u003E\\u00DAltimos 10 pedidos realizados\\u003C/p\\u003E\\n        \\u003CViewportFrame\\n          preset={settings.viewport}\\n          customWidth={settings.customWidth}\\n          title=\\u0022Pedidos recentes\\u0022\\n        \\u003E\\n          \\u003CTableContainer\\u003E\\n            \\u003CTable\\u003E\\n              \\u003CTableCaption\\u003ELista dos 10 pedidos mais recentes\\u003C/TableCaption\\u003E\\n              \\u003CTableHeader\\u003E\\n                \\u003CTableRow\\u003E\\n                  \\