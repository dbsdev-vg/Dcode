ion\\u0022\\u003E\\u00DAltimos 10 pedidos realizados\\u003C/p\\u003E\\n        \\u003CViewportFrame\\n          preset={settings.viewport}\\n          customWidth={settings.customWidth}\\n          title=\\u0022Pedidos recentes\\u0022\\n        \\u003E\\n          \\u003CTableContainer\\u003E\\n            \\u003CTable\\u003E\\n              \\u003CTableCaption\\u003ELista dos 10 pedidos mais recentes\\u003C/TableCaption\\u003E\\n              \\u003CTableHeader\\u003E\\n                \\u003CTableRow\\u003E\\n                  \\u003CTableHead\\u003EID\\u003C/TableHead\\u003E\\n                  \\u003CTableHead\\u003ECliente\\u003C/TableHead\\u003E\\n                  \\u003CTableHead\\u003EData\\u003C/TableHead\\u003E\\n                  \\u003CTableHead\\u003EStatus\\u003C/TableHead\\u003E\\n                  \\u003CTableHead className=\\u0022ui-table__head-cell--right\\u0022\\u003ETotal\\u003C/TableHead\\u003E\\n                \\u003C/TableRow\\u003E\\n              \\u003C/TableHeader\\u003E\\n              \\u003CTableBody\\u003E\\n                {recentOrders.map((pedido) =\\u003E {\\n                  const cliente = CLIENTES.find((c) =\\u003E c.id === pedido.clienteId);\\n                  return (\\n                    \\u003CTableRow key={pedido.id}\\u003E\\n                      \\u003CTableCell\\u003E#{pedido.id}\\u003C/TableCell\\u003E\\n                      \\u003CTableCell\\u003E{cliente?.fantasia || \\u0022N/A\\u0022}\\u003C/TableCell\\u003E\\n                      \\u003CTableCell\\u003E{pedido.data}\\u003C/TableCell\\u003E\\n                      \\u003CTableCell\\u003E\\n                        \\u003CBadge variant={STATUS_VARIANT[pedido.status]}\\u003E\\n                          {pedido.status}\\n                        \\u003C/Badge\\u003E\\n                      \\u003C/TableCell\\u003E\\n                      \\u003CTableCell className=\\u0022ui-table__cell--right\\u0022\\u003E\\n                        {formatBRL(pedido.total)}\\n     