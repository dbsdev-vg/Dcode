ground)\\u0027 }}\\u003E\\u002B {pendingOrders.length - 5} mais\\u003C/li\\u003E}\\n                \\u003C/ul\\u003E\\n              ) : (\\n                \\u003Cp style={{ color: \\u0027var(--muted-foreground)\\u0027 }}\\u003ENenhum pedido pendente \\u2705\\u003C/p\\u003E\\n              )}\\n            \\u003C/CardContent\\u003E\\n          \\u003C/Card\\u003E\\n        \\u003C/div\\u003E\\n      \\u003C/section\\u003E\\n\\n      {/* Top Clients */}\\n      \\u003Csection className=\\u0022section\\u0022\\u003E\\n        \\u003Ch2 className=\\u0022section__title\\u0022\\u003ETop clientes\\u003C/h2\\u003E\\n        \\u003Cp className=\\u0022section__description\\u0022\\u003EClientes com maior volume de compras\\u003C/p\\u003E\\n        \\u003CViewportFrame\\n          preset={settings.viewport}\\n          customWidth={settings.customWidth}\\n          title=\\u0022Top clientes\\u0022\\n        \\u003E\\n          \\u003CTableContainer\\u003E\\n            \\u003CTable\\u003E\\n              \\u003CTableCaption\\u003ETop 5 clientes por volume de compras\\u003C/TableCaption\\u003E\\n              \\u003CTableHeader\\u003E\\n                \\u003CTableRow\\u003E\\n                  \\u003CTableHead\\u003ECliente\\u003C/TableHead\\u003E\\n                  \\u003CTableHead\\u003EEmail\\u003C/TableHead\\u003E\\n                  \\u003CTableHead\\u003EStatus\\u003C/TableHead\\u003E\\n                  \\u003CTableHead className=\\u0022ui-table__head-cell--right\\u0022\\u003ETotal compras\\u003C/TableHead\\u003E\\n                \\u003C/TableRow\\u003E\\n              \\u003C/TableHeader\\u003E\\n              \\u003CTableBody\\u003E\\n                {topClientes.map((cliente) =\\u003E (\\n                  \\u003CTableRow key={cliente.id}\\u003E\\n                    \\u003CTableCell\\u003E\\u003Cstrong\\u003E{cliente.razaoSocial}\\u003C/strong\\u003E\\u003C/TableCell\\u003E\\n                    \\u003CTableCell\\u003E{cliente.email}\\u003C/TableCell\\u003E\\n  